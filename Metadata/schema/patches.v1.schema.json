{
  "$defs": {
    "PatchArtifact": {
      "additionalProperties": false,
      "properties": {
        "file_name": {
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size": {
          "format": "uint64",
          "maximum": 1073741824,
          "minimum": 1,
          "type": "integer"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "sha256",
        "size",
        "file_name"
      ],
      "type": "object"
    },
    "PatchCatalogEntry": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/PatchArtifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "authorization_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "emulators": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "issue_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/PatchKind"
        },
        "license": {
          "type": "string"
        },
        "recipe": {
          "anyOf": [
            {
              "$ref": "#/$defs/PatchRecipe"
            },
            {
              "type": "null"
            }
          ]
        },
        "release_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "title": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "version": {
          "type": "string"
        },
        "vn_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "version",
        "vn_ids",
        "release_ids",
        "emulators",
        "kind",
        "license",
        "summary"
      ],
      "type": "object"
    },
    "PatchKind": {
      "enum": [
        "recipe",
        "external",
        "hosted"
      ],
      "type": "string"
    },
    "PatchRecipe": {
      "additionalProperties": false,
      "properties": {
        "script": {
          "type": "string"
        }
      },
      "required": [
        "script"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entries": {
      "items": {
        "$ref": "#/$defs/PatchCatalogEntry"
      },
      "type": "array"
    },
    "schema": {
      "pattern": "^shinki\\.emu\\.patches\\.v1$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "entries"
  ],
  "title": "PatchCatalog",
  "type": "object"
}
