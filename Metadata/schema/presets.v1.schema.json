{
  "$defs": {
    "Preset": {
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "emulator": {
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "type": "string"
        },
        "patch": {
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "type": [
            "string",
            "null"
          ]
        },
        "release_id": {
          "pattern": "^r[0-9]{1,63}$",
          "type": "string"
        },
        "summary": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "vn_id": {
          "pattern": "^v[0-9]{1,63}$",
          "type": "string"
        }
      },
      "required": [
        "vn_id",
        "release_id",
        "emulator",
        "summary",
        "configuration"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entries": {
      "items": {
        "$ref": "#/$defs/Preset"
      },
      "type": "array"
    },
    "schema": {
      "pattern": "^shinki\\.emu\\.presets\\.v1$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "entries"
  ],
  "title": "PresetDatabase",
  "type": "object"
}
