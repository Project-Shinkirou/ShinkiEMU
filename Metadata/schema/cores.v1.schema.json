{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "CoreCatalogEntry": {
      "additionalProperties": false,
      "properties": {
        "abi": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "display_name": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "family_name": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "license": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "platform": {
          "pattern": "^[a-z0-9_]{1,32}-[a-z0-9_]{1,32}$",
          "type": "string"
        },
        "plugin_id": {
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "type": "string"
        },
        "release_tag": {
          "pattern": "^[A-Za-z0-9._+-]{1,128}$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size": {
          "format": "uint64",
          "maximum": 536870912.0,
          "minimum": 1.0,
          "type": "integer"
        },
        "url": {
          "pattern": "^https://github\\.com/Project-Shinkirou/ShinkiEMU/releases/download/[A-Za-z0-9._+-]+/[A-Za-z0-9._+-]+$",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "abi",
        "display_name",
        "family_name",
        "license",
        "platform",
        "plugin_id",
        "release_tag",
        "sha256",
        "size",
        "url",
        "version"
      ],
      "type": "object"
    }
  },
  "properties": {
    "entries": {
      "items": {
        "$ref": "#/definitions/CoreCatalogEntry"
      },
      "type": "array"
    },
    "schema": {
      "pattern": "^shinki\\.emu\\.cores\\.v1$",
      "type": "string"
    }
  },
  "required": [
    "entries",
    "schema"
  ],
  "title": "CoreCatalog",
  "type": "object"
}
