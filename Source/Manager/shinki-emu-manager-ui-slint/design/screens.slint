    public function signed-out(dark: bool) {
        Mock.base(dark);
        App.page = "steam";
        Steam.login-state = "signed-out";
        Steam.can-import-local = true;
    }

    public function library(dark: bool) {
        Mock.base(dark);
        App.page = "steam";
        Steam.login-state = "signed-in";
        Steam.account-name = "shinki_player";
        Steam.library-state = "ready";
        Steam.games = self.games;
        Steam.library-root = "D:\\Games\\Steam";
    }

    public function select(detail-open: bool) {
        Steam.selected-app-id = 1144400;
        Steam.selected = self.games[2];
        Steam.depots = [
            { depot-id: 1144401, name: "千恋＊万花 Content", platform: "Windows", size: "4.0 GB", selected: true },
            { depot-id: 1144402, name: "千恋＊万花 Mac", platform: "macOS", size: "4.0 GB" },
        ];
        Steam.language-depots = [
            { depot-id: 1144403, language: "简体中文", size: "120 MB", selected: true },
            { depot-id: 1144404, language: "英语", size: "96 MB" },
        ];
        Steam.selected-depot-count = 2;
        Steam.selected-size = "4.1 GB";
        Steam.branches = [{ id: "public", label: "public（默认）" }, { id: "beta", label: "beta" }];
        Steam.selected-branch = "public";
        Steam.detail-open = detail-open;
    }

    public function downloading() {
        Steam.transfer = {
            state: "downloading", app-id: 1144400, name: "千恋＊万花",
            bytes: "1.6 GB / 4.1 GB", files: "812 / 2 140 个文件", speed: "18.4 MB/s", eta: "剩余 2 分 18 秒",
            progress: 0.39, status: "正在下载内容仓库 1144401",
        };
    }
}

