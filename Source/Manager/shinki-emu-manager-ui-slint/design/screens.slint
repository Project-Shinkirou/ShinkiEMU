        Mock.library(false);
        App.appearance.reduce-motion = true;
        Notices.snackbar-text = "已从资料库移除《魔女的夜宴》";
        Notices.snackbar-action = "撤销";
        Notices.snackbar-serial += 1;
    }
}

// ---- 添加游戏 / Steam 下载 ----

export component AddGame inherits ManagerWindow {
    init => {
        Mock.library(false);
        App.page = "add-game";
    }
}

export component SteamSignedOut inherits ManagerWindow {
    init => { SteamMock.signed-out(false); }
}

// Mobile: no local Steam client import; a failed attempt shows its error.
export component SteamSignedOutError inherits ManagerWindow {
    init => {
        SteamMock.signed-out(true);
        Steam.can-import-local = false;
        Steam.login-state = "error";
        Steam.account-name = "shinki_player";
        Steam.error = "账户名或密码不正确。";
    }
}

export component SteamEmailCode inherits ManagerWindow {
    init => {
        SteamMock.signed-out(false);
        Steam.login-state = "email-code";
        Steam.account-name = "shinki_player";
        Steam.guard-hint = "验证码已发送到 s***@example.com。";
    }
}

export component SteamMobileConfirmation inherits ManagerWindow {
    init => {
