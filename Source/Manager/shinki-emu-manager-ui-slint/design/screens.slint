// Design review states for the Manager UI (plan 7.4). Not compiled into the product.
// Render from the worktree root (phone states 360x780, landscape 780x360, others 1280x800):
// slint-viewer --style material -L material=Source/Manager/shinki-emu-manager-ui-slint/material-1.1.0/material.slint --component <Name> --size <WxH> --screenshot .tmp/emu-manager-design/<Name>.png Source/Manager/shinki-emu-manager-ui-slint/design/screens.slint
//
// Every state sets the globals in `init` unconditionally: slint-viewer does not
// compile in preview mode, so `Platform.uses-mock-data` would stay false here.

import {
    ManagerWindow, App, Network, Library, Selection, GameSettings, Patch, Settings, Cores, Notices,
    Dialogs, Filters, Session, Onboarding, ResaleNoticeState, GameCard, CoreInfo, ConfigField, EngineAction, PatchGame,
    Steam, SteamGame, SteamDepot,
} from "../ui/main.slint";

// Steam sub-page of 添加游戏. Names and sizes are illustrative text only.
global SteamMock {
    out property <[SteamGame]> games: [
        { app-id: 1135690, name: "Summer Pockets", size: "6.2 GB", platforms: "Windows", languages: "日语", installed: true, update-available: true },
        { app-id: 2048050, name: "サクラノ詩 －櫻の森の上を舞う－", size: "7.9 GB", platforms: "Windows", languages: "日语 · 英语 · 简体中文", installed: true },
