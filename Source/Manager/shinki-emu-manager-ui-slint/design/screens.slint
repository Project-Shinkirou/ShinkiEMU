    }
}

export component SteamLibraryEmpty inherits ManagerWindow {
    init => {
        SteamMock.library(true);
        Steam.games = [];
    }
}

export component SteamLibraryError inherits ManagerWindow {
    init => {
        SteamMock.library(false);
        Steam.games = [];
        Steam.library-state = "error";
        Steam.error = "网络连接失败，请检查连接后重试";
    }
}

// Desktop master-detail with a running download of the selected game.
export component SteamDownloading inherits ManagerWindow {
    init => {
        SteamMock.library(false);
        SteamMock.select(false);
        SteamMock.downloading();
    }
}

// Installed game with an update, beta branch selected (password pending).
export component SteamDetailBeta inherits ManagerWindow {
    init => {
        SteamMock.library(true);
        SteamMock.select(false);
        Steam.selected-app-id = 1135690;
        Steam.selected = SteamMock.games[0];
        Steam.selected-branch = "beta";
        Steam.transfer = { state: "error", app-id: 1135690, name: "Summer Pockets", progress: -1, error: "分支密码不正确。" };
    }
}

// Phone: list with the running transfer strip.
export component SteamListPhone inherits ManagerWindow {
    init => {
        SteamMock.library(false);
        SteamMock.select(false);
        SteamMock.downloading();
    }
}

