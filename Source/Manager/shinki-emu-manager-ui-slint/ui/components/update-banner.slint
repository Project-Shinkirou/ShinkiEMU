import { MaterialPalette, MaterialText, MaterialTypography, FilledButton, TextButton, IconButton, Icon } from "@material";
import { App, SelfUpdate } from "../globals.slint";
import { Icons } from "../icons.slint";

// Compact new-version notice: the version, at most two lines of release
// notes and the actions. It never takes focus or blocks the page below; the
// host shows it while SelfUpdate.banner-visible is set. The notes row opens
// 设置 → 更新, which shows the full notes.
export component UpdateBanner {
    // Buttons pad their label by 24px per side; 下载 adds an 18px icon and 8px gap.
    property <length> row-width: skip.preferred-width + download.preferred-width + 2 * 48px + 26px + 4px;
    property <bool> stacked: root.row-width > root.width - 24px;

    min-height: body.min-height;
    preferred-height: body.preferred-height;
    accessible-role: groupbox;
    accessible-label: @tr("发现新版本 {}", SelfUpdate.latest-version);

    function open-details() {
        SelfUpdate.dismiss();
        App.settings-category = "updates";
        App.page = "settings";
    }

    Rectangle {
        border-radius: 16px;
        background: MaterialPalette.surface-container-high;
        border-width: 1px;
        border-color: MaterialPalette.outline-variant;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: MaterialPalette.shadow-30;
    }

    // Label measurements for `row-width`; never drawn.
    Rectangle {
        visible: false;
        width: 0px;
        height: 0px;
        skip := MaterialText {
            text: @tr("忽略");
            style: MaterialTypography.label-large;
        }
        download := MaterialText {
            text: @tr("下载");
            style: MaterialTypography.label-large;
        }
    }

    // Swallow clicks so they do not reach the page underneath.
    TouchArea { }

    body := VerticalLayout {
        padding-left: 16px;
        padding-right: 4px;
        padding-top: 4px;
        padding-bottom: 8px;

        HorizontalLayout {
            spacing: 12px;
            height: 48px;

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                Icon {
                    width: 20px;
                    height: 20px;
                    source: Icons.download;
                    colorize: MaterialPalette.primary;
                }
            }
            MaterialText {
                horizontal-stretch: 1;
                text: @tr("发现新版本 {}", SelfUpdate.latest-version);
                style: MaterialTypography.title-small;
                color: MaterialPalette.on-surface;
                vertical-alignment: center;
                overflow: elide;
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                IconButton {
                    icon: Icons.close;
                    tooltip: @tr("稍后");
                    clicked => { SelfUpdate.dismiss(); }
                }
            }
        }

        // Release notes excerpt; the whole row opens the full notes.
        details := Rectangle {
            accessible-role: button;
            accessible-label: @tr("查看详情");
            accessible-action-default => { root.open-details(); }
            min-height: notes.min-height;
            preferred-height: notes.preferred-height;

            Rectangle {
                x: -8px;
                width: parent.width;
                border-radius: 8px;
                background: touch.has-hover ? MaterialPalette.on-surface.with-alpha(0.08) : transparent;
            }

            notes := HorizontalLayout {
                padding-right: 8px;
                spacing: 4px;
                MaterialText {
                    horizontal-stretch: 1;
                    text: SelfUpdate.notes-headline != "" ? SelfUpdate.notes-headline : @tr("查看详情");
                    style: MaterialTypography.body-medium;
                    color: MaterialPalette.on-surface-variant;
                    // One line; 设置 → 更新 shows the full notes.
                    overflow: elide;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Icon {
                        width: 20px;
                        height: 20px;
                        source: Icons.chevron-right;
                        colorize: MaterialPalette.on-surface-variant;
                    }
                }
            }

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open-details(); }
            }
        }

        if !root.stacked : HorizontalLayout {
            padding-top: 4px;
            padding-right: 8px;
            alignment: end;
            spacing: 4px;
            TextButton {
                text: @tr("忽略");
                accessible-label: @tr("忽略此版本");
                clicked => { SelfUpdate.ignore-version(); }
            }
            FilledButton {
                text: @tr("下载");
                accessible-label: @tr("前往下载");
                icon: Icons.download;
                clicked => { SelfUpdate.open-download(); }
            }
        }

        if root.stacked : VerticalLayout {
            padding-top: 4px;
            padding-right: 12px;
            spacing: 4px;
            FilledButton {
                text: @tr("下载");
                accessible-label: @tr("前往下载");
                icon: Icons.download;
                clicked => { SelfUpdate.open-download(); }
            }
            HorizontalLayout {
                alignment: end;
                TextButton {
                    text: @tr("忽略");
                    accessible-label: @tr("忽略此版本");
                    clicked => { SelfUpdate.ignore-version(); }
                }
            }
        }
    }
}
