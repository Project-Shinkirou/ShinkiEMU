import { MaterialPalette, MaterialText, MaterialTypography, LinearProgressIndicator, OutlineButton, TextButton, ScrollView, StateLayerArea, Icon } from "@material";
import { Library } from "../globals.slint";
import { Icons } from "../icons.slint";
import { DialogSurface, Scrim } from "./dialogs.slint";
import { Theme } from "../theme.slint";

// Linear progress that also animates while the total is unknown (Material's indicator stays static).
export component PrepareProgress {
    in property <float> progress;

    property <bool> indeterminate: root.progress < 0;
    property <float> phase: Theme.motion-short == 0ms ? 0.35 : mod(animation-tick() / 1ms, 1600) / 1600;

    height: 4px;
    accessible-role: progress-indicator;
    accessible-value: root.indeterminate ? "" : round(root.progress * 100) + "%";

    if !root.indeterminate : LinearProgressIndicator {
        width: root.width;
        height: root.height;
        progress: clamp(root.progress, 0, 1);
    }

    if root.indeterminate : Rectangle {
        width: root.width;
        height: root.height;
        clip: true;
        border-radius: 2px;
        background: MaterialPalette.primary-container;

        Rectangle {
            x: (root.phase * 1.4 - 0.4) * root.width;
            y: 0px;
            width: root.width * 0.4;
            height: root.height;
            border-radius: 2px;
            background: MaterialPalette.primary;
        }
    }
}

export component LibraryScanStatus {
    in property <bool> show-refresh;
    property <bool> opening: Library.prepare-state == "loading-cores";
    property <bool> scanning: Library.prepare-state == "scanning";
    property <bool> failed: Library.prepare-state == "failed";
    property <bool> busy: root.opening || root.scanning;

    min-height: body.min-height;
    preferred-height: body.preferred-height;
    max-height: body.preferred-height;
    vertical-stretch: 0;

    body := VerticalLayout {
        spacing: 4px;
        if root.busy || root.failed : MaterialText {
            text: root.failed ? (Library.can-refresh ? @tr("无法扫描游戏目录") : @tr("无法打开游戏库"))
                : Library.prepare-detail != "" ? Library.prepare-detail
                : root.scanning ? @tr("正在扫描游戏目录") : @tr("正在打开游戏库");
            style: MaterialTypography.label-large;
            color: root.failed ? MaterialPalette.error : MaterialPalette.on-surface;
            wrap: word-wrap;
            overflow: clip;
        }
        if root.failed : MaterialText {
            text: Library.prepare-detail != "" ? Library.prepare-detail
                : Library.can-refresh ? @tr("请检查文件夹权限，再试一次。") : @tr("请重启 ShinkiEMU 后再试。");
            style: MaterialTypography.body-medium;
            color: MaterialPalette.on-surface-variant;
            wrap: word-wrap;
            overflow: clip;
        }
        if root.busy : PrepareProgress {
            progress: Library.prepare-progress;
        }
        if (root.scanning && Library.can-cancel-prepare) || (root.show-refresh && !root.busy && Library.can-refresh) : HorizontalLayout {
            alignment: start;
            if root.scanning && Library.can-cancel-prepare : TextButton {
                text: @tr("取消扫描");
                clicked => { Library.cancel-prepare(); }
            }
            if root.show-refresh && !root.busy && Library.can-refresh : OutlineButton {
                text: Library.prepare-label;
                icon: Icons.refresh;
                clicked => { Library.prepare(); }
            }
        }
    }
}

export component LibraryImportDialog {
    in property <bool> can-cancel;
    callback cancel();

    Scrim {
        width: root.width;
        height: root.height;
    }

    keys := FocusScope {
        width: root.width;
        height: root.height;
        key-pressed(event) => {
            if event.text == Key.Tab || event.text == Key.Backtab {
                return accept;
            }
            if event.text == Key.Return || event.text == " " {
                root.cancel();
                return accept;
            }
            reject
        }

        surface := DialogSurface {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width-limit: root.width - 32px;
            height-limit: root.height - 32px;
            surface-max-width: 460px;
            title: @tr("正在导入游戏目录…");
            accessible-role: groupbox;
            accessible-label: self.title;
            escape => { root.cancel(); }

            if Library.prepare-detail != "" && Library.prepare-detail != surface.title : MaterialText {
                text: Library.prepare-detail;
                style: MaterialTypography.body-medium;
                color: MaterialPalette.on-surface-variant;
                wrap: word-wrap;
                overflow: clip;
            }

            PrepareProgress {
                progress: Library.prepare-progress;
                accessible-label: surface.title;
            }

            HorizontalLayout {
                alignment: end;
                TextButton {
                    enabled: root.can-cancel;
                    text: @tr("取消");
                    clicked => { root.cancel(); }
                }
            }
        }
    }

    init => { surface.focus(); }
}

// One mounted disc: the volume name with its root path below it.
component OpticalDiscRow {
    in property <string> label;
    in property <string> path;
    callback clicked();

    min-height: 64px;
    preferred-height: 64px;
    forward-focus: area;
    accessible-role: button;
    accessible-label: root.label != "" ? root.label : root.path;
    accessible-description: root.label != "" ? root.path : "";
    accessible-action-default => { root.clicked(); }

    area := StateLayerArea {
        width: root.width;
        height: root.height;
        border-radius: 12px;
        color: MaterialPalette.on-surface;
        clicked => { root.clicked(); }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 16px;

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                Icon {
                    width: 24px;
                    height: 24px;
                    source: Icons.album;
                    colorize: MaterialPalette.on-surface-variant;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                MaterialText {
                    text: root.label != "" ? root.label : root.path;
                    style: MaterialTypography.body-large;
                    color: MaterialPalette.on-surface;
                    overflow: elide;
                }
                if root.label != "" : MaterialText {
                    text: root.path;
                    style: MaterialTypography.body-medium;
                    color: MaterialPalette.on-surface-variant;
                    overflow: elide;
                }
            }
        }
    }
}

// Several mounted discs: the user picks one; nothing is imported until then.
export component OpticalDiscDialog {
    Scrim {
        width: root.width;
        height: root.height;
        dismiss => { Library.close-optical(); }
    }

    surface := DialogSurface {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width-limit: root.width - 32px;
        height-limit: root.height - 32px;
        surface-max-width: 480px;
        icon: Icons.album;
        title: @tr("选择光盘");
        accessible-role: groupbox;
        accessible-label: self.title;
        escape => { Library.close-optical(); }

        MaterialText {
            text: @tr("从光盘直接读取游戏，不会复制到本机。");
            style: MaterialTypography.body-medium;
            color: MaterialPalette.on-surface-variant;
            wrap: word-wrap;
            overflow: clip;
        }

        ScrollView {
            vertical-stretch: 1;
            min-height: min(Library.optical-choices.length * 64px, 128px);
            preferred-height: Library.optical-choices.length * 64px;
            VerticalLayout {
                for disc[index] in Library.optical-choices : OpticalDiscRow {
                    label: disc.label;
                    path: disc.id;
                    clicked => { Library.import-optical(index); }
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            TextButton {
                text: @tr("取消");
                clicked => { Library.close-optical(); }
            }
        }
    }

    init => { surface.focus(); }
}
