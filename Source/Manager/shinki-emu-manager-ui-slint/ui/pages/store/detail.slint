import {
    MaterialPalette, MaterialText, MaterialTypography, ScrollView, TextField, FilledButton, TonalButton,
    OutlineButton, TextButton, IconButton, Icon,
} from "@material";
import { Store } from "../../globals.slint";
import { Icons } from "../../icons.slint";
import { ChoiceSelect, SupportingText } from "../../components/select.slint";
import { GameBadges, DepotRow, TransferPanel, StoreText } from "./parts.slint";

component Section {
    in property <string> title;
    in property <string> description;

    min-height: l.min-height;
    preferred-height: l.preferred-height;

    l := VerticalLayout {
        spacing: 8px;
        VerticalLayout {
            spacing: 2px;
            padding-left: 4px;
            padding-right: 4px;
            MaterialText {
                text: root.title;
                style: MaterialTypography.title-small;
                color: MaterialPalette.primary;
            }
            if root.description != "" : MaterialText {
                text: root.description;
                style: MaterialTypography.body-medium;
                color: MaterialPalette.on-surface-variant;
                wrap: word-wrap;
                overflow: clip;
            }
        }
        Rectangle {
            border-radius: 16px;
            background: MaterialPalette.surface-container-low;
            border-width: 1px;
            border-color: MaterialPalette.outline-variant;
            clip: true;
            VerticalLayout {
                padding: 8px;
                spacing: 8px;
                @children
            }
        }
    }
}

// Selected owned game: depots, languages, branch, library folder, actions and
// progress. `sheet` draws it as a full-screen phone sheet with its own back arrow.
export component StoreDetail {
    in property <bool> sheet;
    callback close();

    property <bool> busy: StoreText.transfer-active(Store.transfer.state);
    // Progress of another game blocks starting this one; the backend runs one transfer.
    property <bool> this-transfer: Store.transfer.title-id == Store.selected.title-id && Store.transfer.state != "idle";
    property <bool> needs-branch-password: Store.selected-branch != "" && Store.selected-branch != "public";
    property <bool> can-download: !root.busy && (!Store.has-depots || Store.selected-depot-count > 0) && Store.library-root != "" && Store.selected.unavailable-reason == "" && Store.library-state == "ready";
    property <length> pad: root.sheet ? 16px : 24px;

    init => { keys.focus(); }

    TouchArea { }

    Rectangle {
        background: MaterialPalette.surface;
    }

    keys := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if root.sheet && (event.text == Key.Escape || event.text == Key.Back) {
                root.close();
                return accept;
            }
            reject
        }

        sv := ScrollView {
            width: 100%;
            height: 100%;

            HorizontalLayout {
                width: sv.visible-width;
                padding-left: root.pad;
                padding-right: root.pad;
                padding-top: root.sheet ? 4px : 16px;
                padding-bottom: 32px;
                alignment: start;

                VerticalLayout {
                    width: min(680px, sv.visible-width - 2 * root.pad);
                    spacing: 20px;
                    alignment: start;

                    // Header: name, facts and badges.
                    HorizontalLayout {
                        spacing: 8px;
                        if root.sheet : VerticalLayout {
                            alignment: start;
                            horizontal-stretch: 0;
                            IconButton {
                                icon: Icons.arrow-back;
                                tooltip: @tr("返回游戏列表");
                                clicked => { root.close(); }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;
                            padding-top: root.sheet ? 8px : 0px;
                            MaterialText {
                                text: Store.selected.name;
                                style: root.sheet ? MaterialTypography.title-large : MaterialTypography.headline-small;
                                color: MaterialPalette.on-surface;
                                wrap: word-wrap;
                                overflow: clip;
                            }
                            MaterialText {
                                text: @tr("作品 ID {}", Store.selected.title-id)
                                    + (Store.selected.size != "" ? " · " + Store.selected.size : "")
                                    + (Store.selected.platforms != "" ? " · " + Store.selected.platforms : "");
                                style: MaterialTypography.body-medium;
                                color: MaterialPalette.on-surface-variant;
                                wrap: word-wrap;
                                overflow: clip;
                            }
                            HorizontalLayout {
                                alignment: start;
                                GameBadges { game: Store.selected; }
                            }
                        }
                    }

                    if root.this-transfer : TransferPanel {
                        transfer: Store.transfer;
                    }
                    if Store.selected.unavailable-reason != "" : SupportingText {
                        text: Store.selected.unavailable-reason;
                        error: true;
                    }

                    if Store.has-depots : Section {
                        title: @tr("内容仓库");
                        description: Store.depots.length == 0 ? @tr("正在读取内容仓库…") : @tr("默认选中 Windows 版本。");
                        for depot in Store.depots : DepotRow {
                            depot: depot;
                            enabled: !root.busy;
                        }
                    }

                    if Store.has-depots && Store.language-depots.length > 0 : Section {
                        title: @tr("语言");
                        description: @tr("额外下载的语言内容。");
                        for depot in Store.language-depots : DepotRow {
                            depot: depot;
                            enabled: !root.busy;
                        }
                    }

                    if Store.has-branches && Store.branches.length > 0 : VerticalLayout {
                        spacing: 12px;
                        ChoiceSelect {
                            label: @tr("分支");
                            choices: Store.branches;
                            value: Store.selected-branch;
                            enabled: !root.busy;
                            selected(id) => { Store.select-branch(id, ""); }
                        }
                        if root.needs-branch-password : HorizontalLayout {
                            spacing: 8px;
                            branch-password := TextField {
                                horizontal-stretch: 1;
                                label: @tr("分支密码");
                                input-type: InputType.password;
                                enabled: !root.busy;
                                supporting-text: Store.branch-password-set ? @tr("已输入分支密码") : @tr("测试分支需要密码时填写；不会保存。");
                                accepted(text) => {
                                    if text != "" {
                                        Store.select-branch(Store.selected-branch, text);
                                        self.text = "";
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: start;
                                horizontal-stretch: 0;
                                padding-top: 8px;
                                TonalButton {
                                    text: @tr("应用");
                                    enabled: !root.busy && branch-password.text != "";
                                    clicked => {
                                        Store.select-branch(Store.selected-branch, branch-password.text);
                                        branch-password.text = "";
                                    }
                                }
                            }
                        }
                    }

                    // Library folder: path plus a platform folder picker.
                    VerticalLayout {
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 8px;
                            TextField {
                                horizontal-stretch: 1;
                                label: @tr("游戏库目录");
                                text: Store.library-root;
                                read-only: true;
                                leading-icon: Icons.folder-open;
                            }
                            VerticalLayout {
                                alignment: start;
                                horizontal-stretch: 0;
                                padding-top: 8px;
                                OutlineButton {
                                    text: @tr("选择…");
                                    enabled: !root.busy;
                                    clicked => { Store.choose-library-root(); }
                                }
                            }
                        }
                        if Store.library-root == "" : SupportingText {
                            text: @tr("请选择下载到哪个文件夹。");
                            error: true;
                        }
                    }

                    // Actions; wraps to a column on narrow sheets.
                    if !root.sheet : HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        if root.busy && root.this-transfer : OutlineButton {
                            text: @tr("取消");
                            enabled: Store.transfer.state != "cancelling";
                            clicked => { Store.cancel(); }
                        }
                        if Store.can-verify && Store.selected.installed : OutlineButton {
                            icon: Icons.build;
                            text: @tr("校验并修复");
                            enabled: !root.busy;
                            clicked => { Store.verify(); }
                        }
                        if Store.selected.installed && !Store.selected.update-unknown : TonalButton {
                            icon: Icons.refresh;
                            text: @tr("检查更新");
                            enabled: !root.busy;
                            clicked => { Store.check-updates(); }
                        }
                        FilledButton {
                            icon: Icons.download;
                            text: Store.selected.update-available ? @tr("下载更新") : @tr("下载");
                            enabled: root.can-download;
                            clicked => { Store.download(); }
                        }
                    }
                    if root.sheet : VerticalLayout {
                        spacing: 8px;
                        FilledButton {
                            icon: Icons.download;
                            text: Store.selected.update-available ? @tr("下载更新") : @tr("下载");
                            enabled: root.can-download;
                            clicked => { Store.download(); }
                        }
                        if root.busy && root.this-transfer : OutlineButton {
                            text: @tr("取消");
                            enabled: Store.transfer.state != "cancelling";
                            clicked => { Store.cancel(); }
                        }
                        if Store.selected.installed && !Store.selected.update-unknown : TonalButton {
                            icon: Icons.refresh;
                            text: @tr("检查更新");
                            enabled: !root.busy;
                            clicked => { Store.check-updates(); }
                        }
                        if Store.can-verify && Store.selected.installed : OutlineButton {
                            icon: Icons.build;
                            text: @tr("校验并修复");
                            enabled: !root.busy;
                            clicked => { Store.verify(); }
                        }
                    }
                    if Store.selected-depot-count > 0 : MaterialText {
                        text: Store.selected-size != "" ? @tr("已选 {0} 个内容仓库，共 {1}", Store.selected-depot-count, Store.selected-size) : @tr("已选 {} 个内容仓库", Store.selected-depot-count);
                        style: MaterialTypography.body-medium;
                        color: MaterialPalette.on-surface-variant;
                        horizontal-alignment: root.sheet ? left : right;
                        wrap: word-wrap;
                        overflow: clip;
                    }
                }
            }
        }
    }
}
