import {
    MaterialPalette, MaterialText, MaterialTypography, ScrollView, TextField, FilledButton, TonalButton,
    OutlineButton, TextButton, CircularProgressIndicator, HorizontalDivider, Icon,
} from "@material";
import { Store } from "../../globals.slint";
import { Icons } from "../../icons.slint";
import { ErrorBanner } from "./parts.slint";

// Rounded section card of the login column.
component LoginCard {
    in property <string> title;
    in property <string> description;

    min-height: l.min-height;
    preferred-height: l.preferred-height;

    Rectangle {
        border-radius: 16px;
        background: MaterialPalette.surface-container-low;
        border-width: 1px;
        border-color: MaterialPalette.outline-variant;
    }

    l := VerticalLayout {
        padding: 16px;
        spacing: 16px;

        if root.title != "" || root.description != "" : VerticalLayout {
            spacing: 4px;
            if root.title != "" : MaterialText {
                text: root.title;
                style: MaterialTypography.title-medium;
                color: MaterialPalette.on-surface;
                wrap: word-wrap;
                overflow: clip;
            }
            if root.description != "" : MaterialText {
                text: root.description;
                style: MaterialTypography.body-medium;
                color: MaterialPalette.on-surface-variant;
                wrap: word-wrap;
                overflow: clip;
            }
        }

        @children
    }
}

// Account + password form. The password lives only in this field and is
// cleared right after it is handed to the callback.
component PasswordForm {
    in property <bool> enabled: true;

    property <bool> ready: account.text != "" && password.text != "";

    function submit() {
        if root.ready && root.enabled {
            Store.login(account.text, password.text);
            password.text = "";
        }
    }

    min-height: l.min-height;
    preferred-height: l.preferred-height;

    l := VerticalLayout {
        spacing: 12px;

        account := TextField {
            label: @tr("{} 账户名", Store.provider-name);
            text: Store.account-name;
            enabled: root.enabled;
            input-type: InputType.text;
            accepted => { password.focus(); }
        }
        password := TextField {
            label: @tr("密码");
            enabled: root.enabled;
            input-type: InputType.password;
            supporting-text: @tr("密码只用于本次登录；登录凭据保存在系统凭据库中。");
            accepted => { root.submit(); }
        }
        HorizontalLayout {
            alignment: end;
            FilledButton {
                text: @tr("登录");
                enabled: root.ready && root.enabled;
                clicked => { root.submit(); }
            }
        }
    }
}

// Store Guard: email or mobile authenticator code.
component GuardForm {
    in property <bool> email;

    function submit() {
        if code.text != "" {
            Store.submit-guard(code.text);
            code.text = "";
        }
    }

    init => { code.focus(); }

    min-height: l.min-height;
    preferred-height: l.preferred-height;

    l := VerticalLayout {
        spacing: 12px;

        code := TextField {
            label: root.email ? @tr("邮箱验证码") : @tr("手机令牌验证码");
            input-type: InputType.text;
            supporting-text: Store.guard-hint != "" ? Store.guard-hint
                : root.email ? @tr("验证码已发送至你的邮箱。") : @tr("打开商店手机应用，输入令牌中显示的验证码。");
            accepted => { root.submit(); }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            TextButton {
                text: @tr("取消");
                clicked => { Store.logout(); }
            }
            FilledButton {
                text: @tr("提交");
                enabled: code.text != "";
                clicked => { root.submit(); }
            }
        }
    }
}

// Spinner + message for a pending step that only offers cancel.
component PendingStep {
    in property <string> title;
    in property <string> body;

    min-height: l.min-height;
    preferred-height: l.preferred-height;

    l := VerticalLayout {
        spacing: 16px;
        HorizontalLayout {
            spacing: 16px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                CircularProgressIndicator {
                    width: 40px;
                    height: 40px;
                    indeterminate: true;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 4px;
                MaterialText {
                    text: root.title;
                    style: MaterialTypography.title-medium;
                    color: MaterialPalette.on-surface;
                    wrap: word-wrap;
                    overflow: clip;
                }
                if root.body != "" : MaterialText {
                    text: root.body;
                    style: MaterialTypography.body-medium;
                    color: MaterialPalette.on-surface-variant;
                    wrap: word-wrap;
                    overflow: clip;
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            TextButton {
                text: @tr("取消");
                clicked => { Store.logout(); }
            }
        }
    }
}

// Signed-out and pending login states of the Store sub-page.
export component StoreLogin {
    in property <bool> compact;

    property <string> state: Store.login-state;
    property <bool> choosing: root.state == "signed-out" || root.state == "error";
    property <length> pad: root.compact ? 16px : 24px;

    sv := ScrollView {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;

        HorizontalLayout {
            width: sv.visible-width;
            padding-left: root.pad;
            padding-right: root.pad;
            padding-top: 8px;
            padding-bottom: 32px;
            alignment: center;

            VerticalLayout {
                width: min(520px, sv.visible-width - 2 * root.pad);
                spacing: 16px;
                alignment: start;

                if root.choosing : MaterialText {
                    text: @tr("登录 {} 后可以下载你已拥有的游戏。", Store.provider-name);
                    style: MaterialTypography.body-large;
                    color: MaterialPalette.on-surface-variant;
                    wrap: word-wrap;
                    overflow: clip;
                }

                if Store.error != "" : ErrorBanner {
                    title: @tr("登录失败");
                    text: Store.error;
                }

                if root.choosing && Store.can-credentials : LoginCard {
                    title: @tr("账户密码登录");
                    PasswordForm { }
                }

                if root.choosing && (Store.can-qr || Store.can-import-local) : LoginCard {
                    title: @tr("其他登录方式");
                    VerticalLayout {
                        spacing: 8px;
                        if Store.can-qr : TonalButton {
                            icon: Icons.qr-code;
                            text: @tr("扫码登录");
                            clicked => { Store.qr-login(); }
                        }
                        if Store.can-import-local : OutlineButton {
                            icon: Icons.upload-file;
                            text: @tr("导入 {} 客户端登录", Store.provider-name);
                            clicked => { Store.import-local(); }
                        }
                    }
                }

                if root.choosing && Store.can-web : LoginCard {
                    title: @tr("网页登录");
                    description: @tr("在内置浏览器中打开 {} 的登录页。登录完成后会自动继续，登录凭据只保存在系统凭据库中。", Store.provider-name);
                    HorizontalLayout {
                        alignment: end;
                        FilledButton {
                            text: @tr("打开登录页");
                            clicked => { Store.web-login(); }
                        }
                    }
                }

                if root.state == "connecting" : LoginCard {
                    PendingStep {
                        title: @tr("正在连接 {}", Store.provider-name);
                        body: Store.status;
                    }
                }

                if root.state == "email-code" || root.state == "mobile-code" : LoginCard {
                    title: @tr("验证码验证");
                    description: Store.account-name != "" ? @tr("账户：{}", Store.account-name) : "";
                    GuardForm { email: root.state == "email-code"; }
                }

                if root.state == "mobile-confirmation" : LoginCard {
                    PendingStep {
                        title: @tr("请在 {} 手机应用中确认", Store.provider-name);
                        body: Store.guard-hint != "" ? Store.guard-hint : @tr("在手机上批准这次登录后会自动继续。");
                    }
                }

                if root.state == "qr-code" : LoginCard {
                    title: @tr("扫码登录");
                    description: @tr("用 {} 手机应用扫描二维码并确认登录。", Store.provider-name);

                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 232px;
                            height: 232px;
                            border-radius: 12px;
                            // Quiet zone stays white in dark mode so the code scans.
                            background: white;
                            accessible-role: image;
                            accessible-label: @tr("登录二维码");

                            if Store.qr.width > 0 : Image {
                                width: 200px;
                                height: 200px;
                                source: Store.qr;
                                image-rendering: pixelated;
                                image-fit: contain;
                            }
                            if Store.qr.width == 0 : CircularProgressIndicator {
                                width: 40px;
                                height: 40px;
                                indeterminate: true;
                            }
                        }
                    }
                    if Store.status != "" : MaterialText {
                        text: Store.status;
                        style: MaterialTypography.body-medium;
                        color: MaterialPalette.on-surface-variant;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        overflow: clip;
                    }
                    HorizontalLayout {
                        alignment: end;
                        TextButton {
                            text: @tr("取消");
                            clicked => { Store.logout(); }
                        }
                    }
                }
            }
        }
    }
}

// The store's own sign-in page. The host places the platform webview over
// `page`, whose window position it reads from `Store.web-area-*`; Linux and
// Android show the page in a window of their own instead.
export component StoreWebArea {
    in property <bool> compact;

    property <length> pad: root.compact ? 8px : 16px;
    property <length> bar: 56px;

    // Logical window coordinates of `page`, pushed whenever they change.
    property <length> page-x: root.absolute-position.x + page.x;
    property <length> page-y: root.absolute-position.y + page.y;
    property <length> page-width: page.width;
    property <length> page-height: page.height;
    function publish() {
        Store.web-area-x = root.page-x;
        Store.web-area-y = root.page-y;
        Store.web-area-width = root.page-width;
        Store.web-area-height = root.page-height;
    }
    init => { root.publish(); }
    changed page-x => { root.publish(); }
    changed page-y => { root.publish(); }
    changed page-width => { root.publish(); }
    changed page-height => { root.publish(); }

    HorizontalLayout {
        x: root.pad;
        y: 0px;
        width: root.width - 2 * root.pad;
        height: root.bar;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            MaterialText {
                text: @tr("在 {} 登录页中登录，完成后会自动继续。", Store.provider-name);
                style: MaterialTypography.body-medium;
                color: MaterialPalette.on-surface-variant;
                wrap: word-wrap;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            TextButton {
                text: @tr("取消");
                clicked => { Store.cancel-web-login(); }
            }
        }
    }

    page := Rectangle {
        x: root.pad;
        y: root.bar;
        width: max(0px, root.width - 2 * root.pad);
        height: max(0px, root.height - root.bar - root.pad);
        border-radius: 12px;
        background: MaterialPalette.surface-container-low;

        CircularProgressIndicator {
            width: 40px;
            height: 40px;
            indeterminate: true;
        }
    }
}
