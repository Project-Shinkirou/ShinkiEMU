import { MaterialPalette, MaterialText, MaterialTypography, SmallAppBar, TextField, FilledButton, OutlineButton, TextButton, FilterChip } from "@material";
import { App, Library, Store, Settings } from "../globals.slint";
import { Icons } from "../icons.slint";
import { ChoiceSelect } from "../components/select.slint";
import { Segments } from "../components/segments.slint";
import { PageScroll, SettingGroup } from "./settings/common.slint";
import { PrepareProgress } from "./library.slint";

// Material chips toggle themselves. Keep the current selection checked on repeat clicks.
component CompatChip {
    in property <string> id;
    in property <string> text;
    property <bool> current: Library.compat-filter == root.id;
    property <bool> checked: chip.checked;

    changed checked => {
        if root.checked && !root.current {
            Library.set-compat-filter(root.id);
        } else if !root.checked && root.current {
            chip.checked = true;
        }
    }
    changed current => { chip.checked = root.current; }

    chip := FilterChip {
        text: root.text;
        checked: root.current;
    }
}

export component LibraryManagementPage {
    in property <bool> compact;
    property <bool> scanning: Library.prepare-state == "scanning";
    property <bool> opening: Library.prepare-state == "loading-cores";
    property <bool> failed: Library.prepare-state == "failed";
    property <length> bar-height: 64px;

    init => { keys.focus(); }

    keys := FocusScope {
        width: root.width;
        height: root.height;
        key-pressed(event) => {
            if event.modifiers.control && (event.text == "f" || event.text == "F") {
                search.focus();
                search.select-all();
                return accept;
            }
            reject
        }

        Rectangle { background: MaterialPalette.surface; }

        SmallAppBar {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.bar-height;
            title: @tr("管理游戏库");
            leading-button: { icon: Icons.arrow-back, tooltip: @tr("返回游戏库"), enabled: true };
            leading-button-clicked => { App.page = "library"; }
        }

        PageScroll {
            y: root.bar-height;
            width: root.width;
            height: root.height - root.bar-height;

            SettingGroup {
                title: @tr("游戏文件夹");
                VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        alignment: start;
                        FilledButton {
                            text: @tr("添加文件夹");
                            icon: Icons.add;
                            clicked => { Library.add-directory(); }
                        }
                    }
                    if root.opening || root.scanning || root.failed : MaterialText {
                        text: root.failed ? (Library.can-refresh ? @tr("无法扫描游戏目录") : @tr("无法打开游戏库"))
                            : root.scanning ? @tr("正在扫描游戏目录") : @tr("正在打开游戏库");
                        style: MaterialTypography.title-small;
                        color: root.failed ? MaterialPalette.error : MaterialPalette.on-surface;
                        wrap: word-wrap;
                        overflow: clip;
                    }
                    if (root.scanning || root.failed) && Library.prepare-detail != "" : MaterialText {
                        text: Library.prepare-detail;
                        style: MaterialTypography.body-medium;
                        color: MaterialPalette.on-surface-variant;
                        wrap: word-wrap;
                        overflow: clip;
                    }
                    if root.failed && Library.prepare-detail == "" : MaterialText {
                        text: Library.can-refresh ? @tr("请检查文件夹权限，再试一次。") : @tr("请重启 ShinkiEMU 后再试。");
                        style: MaterialTypography.body-medium;
                        color: MaterialPalette.on-surface-variant;
                        wrap: word-wrap;
                        overflow: clip;
                    }
                    if root.opening || root.scanning : PrepareProgress {
                        progress: Library.prepare-progress;
                    }
                    if Library.can-cancel-prepare || Library.can-refresh : HorizontalLayout {
                        alignment: start;
                        if Library.can-cancel-prepare : TextButton {
                            text: @tr("取消扫描");
                            clicked => { Library.cancel-prepare(); }
                        }
                        if Library.can-refresh : OutlineButton {
                            text: Library.prepare-label;
                            icon: Icons.refresh;
                            clicked => { Library.prepare(); }
                        }
                    }
                    if root.failed || Settings.roots.length > 0 : HorizontalLayout {
                        alignment: start;
                        TextButton {
                            text: @tr("管理文件夹");
                            clicked => {
                                App.settings-category = "library-roots";
                                App.page = "settings";
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        TextButton {
                            text: @tr("商店下载");
                            icon: Icons.download;
                            clicked => {
                                App.page = "store";
                                Store.open();
                            }
                        }
                    }
                }
            }

            SettingGroup {
                title: @tr("搜索与筛选");
                VerticalLayout {
                    spacing: 8px;
                    search := TextField {
                        label: @tr("搜索游戏标题");
                        accessible-label: @tr("搜索游戏标题");
                        text <=> Library.query;
                        edited(text) => { Library.search(text); }
                    }
                    MaterialText {
                        text: @tr("兼容性");
                        style: MaterialTypography.label-large;
                    }
                    FlexboxLayout {
                        spacing: 8px;
                        alignment: start;
                        CompatChip { id: "all"; text: @tr("全部"); }
                        CompatChip { id: "perfect"; text: @tr("完美"); }
                        CompatChip { id: "completable"; text: @tr("可通关"); }
                        CompatChip { id: "flawed"; text: @tr("有瑕疵"); }
                        CompatChip { id: "boot_only"; text: @tr("仅能启动"); }
                        CompatChip { id: "unplayable"; text: @tr("无法运行"); }
                        CompatChip { id: "unknown"; text: @tr("未评级"); }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        ChoiceSelect {
                            horizontal-stretch: 1;
                            label: @tr("排序");
                            value: Library.sort;
                            choices: [
                                { id: "title", label: @tr("标题") },
                                { id: "recent", label: @tr("最近游玩") },
                                { id: "play_time", label: @tr("游玩时长") },
                            ];
                            selected(id) => { Library.set-sort(id); }
                        }
                        VerticalLayout {
                            horizontal-stretch: 0;
                            alignment: center;
                            Segments {
                                width: root.compact ? 144px : 208px;
                                label: @tr("视图");
                                items: [@tr("网格"), @tr("列表")];
                                index: App.appearance.view-mode == "list" ? 1 : 0;
                                selected(index) => {
                                    App.appearance.view-mode = index == 1 ? "list" : "grid";
                                    App.appearance-changed(App.appearance);
                                }
                            }
                        }
                    }
                    if Library.query != "" || Library.compat-filter != "all" : HorizontalLayout {
                        alignment: start;
                        TextButton {
                            text: @tr("清除搜索和筛选");
                            clicked => {
                                if Library.query != "" { Library.search(""); }
                                if Library.compat-filter != "all" { Library.set-compat-filter("all"); }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        OutlineButton {
                            text: @tr("查看游戏（{n}）" | "查看游戏（{n}）" % Library.games.length);
                            clicked => { App.page = "library"; }
                        }
                    }
                }
            }
        }
    }
}
