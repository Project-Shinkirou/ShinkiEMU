import { MaterialPalette, MaterialText, MaterialTypography, SmallAppBar, ScrollView, TextField, TextButton, OutlineButton, VerticalDivider, Icon } from "@material";
import { App, Steam } from "../globals.slint";
import { Icons } from "../icons.slint";
import { Theme } from "../theme.slint";
import { SteamLogin } from "./steam/login.slint";
import { SteamDetail } from "./steam/detail.slint";
import { SteamGameRow, StateMessage, ErrorBanner, TransferPanel } from "./steam/parts.slint";

// Owned-games list with search, account row and the running transfer.
component SteamLibrary {
    in property <bool> show-transfer;
    callback chosen(app-id: int);

    function clear-search() {
        debounce.running = false;
        Steam.query = "";
        Steam.search("");
    }

    debounce := Timer {
        interval: 300ms;
        running: false;
        triggered => {
            self.running = false;
            Steam.search(Steam.query);
        }
    }

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 8px;
        spacing: 12px;

        // Account.
        HorizontalLayout {
            spacing: 8px;
            MaterialText {
                horizontal-stretch: 1;
                text: Steam.account-name != "" ? "已登录：" + Steam.account-name : "已登录 Steam";
                style: MaterialTypography.body-medium;
                color: MaterialPalette.on-surface-variant;
                vertical-alignment: center;
                overflow: elide;
            }
            TextButton {
                horizontal-stretch: 0;
                text: "退出登录";
                enabled: !(Steam.transfer.state == "preparing" || Steam.transfer.state == "downloading" || Steam.transfer.state == "verifying" || Steam.transfer.state == "cancelling");
                clicked => { Steam.logout(); }
            }
        }

        TextField {
            label: "搜索已拥有的游戏";
            leading-icon: Icons.search;
            trailing-icon: Steam.query != "" ? Icons.close : @image-url("");
            text <=> Steam.query;
            edited => { debounce.restart(); }
            accepted => {
                debounce.running = false;
                Steam.search(Steam.query);
            }
            trailing-icon-clicked => { root.clear-search(); }
        }

        if root.show-transfer : TransferPanel {
            transfer: Steam.transfer;
            show-name: true;
        }

        Rectangle {
            vertical-stretch: 1;

            list := ScrollView {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                visible: Steam.games.length > 0;

                VerticalLayout {
                    width: list.visible-width;
                    padding-bottom: 24px;
                    spacing: 2px;
                    alignment: start;

                    for game in Steam.games : SteamGameRow {
                        game: game;
                        selected: game.app-id == Steam.selected-app-id;
                        activate => { root.chosen(game.app-id); }
                    }
                }
            }

            if Steam.games.length == 0 : VerticalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                alignment: center;
                padding-bottom: 48px;

                if Steam.library-state == "loading" || Steam.library-state == "idle" : StateMessage {
                    busy: true;
                    title: "加载游戏库";
                    body: Steam.status;
                }
                if Steam.library-state == "error" : StateMessage {
                    icon: Icons.error;
                    error: true;
                    title: "游戏库加载失败";
                    body: Steam.error;
                    HorizontalLayout {
                        alignment: center;
                        OutlineButton {
                            icon: Icons.refresh;
                            text: "重试";
                            clicked => { Steam.refresh-library(); }
                        }
                    }
                }
                if Steam.library-state == "ready" && Steam.query != "" : StateMessage {
                    icon: Icons.search;
                    title: "没有找到“" + Steam.query + "”";
                    body: "换个关键词试试。";
                    HorizontalLayout {
                        alignment: center;
                        OutlineButton {
                            text: "清除搜索";
                            clicked => { root.clear-search(); }
                        }
                    }
                }
                if Steam.library-state == "ready" && Steam.query == "" : StateMessage {
                    icon: Icons.library-books;
                    title: "这个账户还没有游戏";
                    body: "在 Steam 购买或领取游戏后，刷新即可看到。";
                    HorizontalLayout {
                        alignment: center;
                        OutlineButton {
                            icon: Icons.refresh;
                            text: "刷新";
                            clicked => { Steam.refresh-library(); }
                        }
                    }
                }
            }

            // A refresh failure keeps the old list; say so above it.
            if Steam.games.length > 0 && Steam.library-state == "error" && Steam.error != "" : ErrorBanner {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: self.preferred-height;
                text: Steam.error;
            }
        }
    }
}

// Steam 下载: login, then the owned-games master-detail view. Phones and
// medium widths show the selected game as a full-screen sheet.
export component SteamPage {
    in property <bool> compact;

    property <length> bar-height: 64px;
    property <bool> signed-in: Steam.login-state == "signed-in";
    property <bool> two-pane: root.width >= 760px;
    property <length> list-width: clamp(root.width * 0.4, 320px, 440px);
    property <bool> has-selection: Steam.selected.app-id != 0;
    property <bool> sheet-open: root.signed-in && !root.two-pane && Steam.detail-open && root.has-selection;
    // Widening a phone sheet into master-detail drops its back-stack level.
    changed two-pane => {
        if root.two-pane {
            Steam.detail-open = false;
        }
    }

    function choose(app-id: int) {
        Steam.selected-app-id = app-id;
        Steam.select-game(app-id);
        // Only the phone sheet is a separate back-stack level.
        Steam.detail-open = !root.two-pane;
    }

    Rectangle {
        background: MaterialPalette.surface;
    }
    SmallAppBar {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.bar-height;
        title: "Steam 下载";
        leading-button: { icon: Icons.arrow-back, tooltip: "返回添加游戏", enabled: true };
        leading-button-clicked => { App.page = "add-game"; }
        trailing-buttons: root.signed-in ? [{ icon: Icons.refresh, tooltip: "刷新游戏库", enabled: Steam.library-state != "loading" }] : [];
        trailing-button-clicked(index) => { Steam.refresh-library(); }
    }

    if !root.signed-in : SteamLogin {
        x: 0px;
        y: root.bar-height;
        width: root.width;
        height: root.height - root.bar-height;
        compact: root.compact;
    }

    if root.signed-in : SteamLibrary {
        x: 0px;
        y: root.bar-height;
        width: root.two-pane ? root.list-width : root.width;
        height: root.height - root.bar-height;
        show-transfer: Steam.transfer.state != "idle" && (!root.two-pane || Steam.transfer.app-id != Steam.selected.app-id);
        chosen(app-id) => { root.choose(app-id); }
    }

    if root.signed-in && root.two-pane : Rectangle {
        x: root.list-width;
        y: root.bar-height;
        width: 1px;
        height: root.height - root.bar-height;
        background: MaterialPalette.outline-variant;
    }

    if root.signed-in && root.two-pane && root.has-selection : SteamDetail {
        x: root.list-width + 1px;
        y: root.bar-height;
        width: root.width - root.list-width - 1px;
        height: root.height - root.bar-height;
    }

    if root.signed-in && root.two-pane && !root.has-selection : StateMessage {
        x: root.list-width + 1px;
        y: root.bar-height;
        width: root.width - root.list-width - 1px;
        height: root.height - root.bar-height;
        icon: Icons.download;
        title: "选择一款游戏";
        body: "选择内容仓库、语言和分支后即可下载。";
    }

    if root.sheet-open : SteamDetail {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        sheet: true;
        close => { Steam.detail-open = false; }
    }
}
