import { MaterialPalette, SmallAppBar } from "@material";
import { App } from "../globals.slint";
import { Icons } from "../icons.slint";
import { FilterChainScroll } from "../components/filter-chain.slint";

export component FiltersPage {
    in property <bool> compact;
    property <length> bar-height: 64px;

    Rectangle {
        background: MaterialPalette.surface;
    }

    SmallAppBar {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.bar-height;
        title: @tr("滤镜");
        leading-button: root.compact ? { icon: Icons.arrow-back, tooltip: @tr("返回游戏库"), enabled: true } : { };
        leading-button-clicked => { App.page = "library"; }
    }

    FilterChainScroll {
        x: 0px;
        y: root.bar-height;
        width: root.width;
        height: root.height - root.bar-height;
    }
}
