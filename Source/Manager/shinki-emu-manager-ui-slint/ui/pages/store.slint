import { MaterialPalette, MaterialText, MaterialTypography, SmallAppBar, ScrollView, TextField, TextButton, OutlineButton, VerticalDivider, Icon } from "@material";
import { App, Store } from "../globals.slint";
import { Icons } from "../icons.slint";
import { Theme } from "../theme.slint";
import { StoreLogin } from "./store/login.slint";
import { StoreDetail } from "./store/detail.slint";
import { StoreGameRow, StateMessage, ErrorBanner, TransferPanel } from "./store/parts.slint";
import { ChoiceSelect } from "../components/select.slint";

// Owned-games list with search, account row and the running transfer.
component StoreLibrary {
    in property <bool> show-transfer;
    callback chosen(title-id: string);

    function clear-search() {
        debounce.running = false;
        Store.query = "";
        Store.search("");
    }

    debounce := Timer {
        interval: 300ms;
        running: false;
        triggered => {
            self.running = false;
            Store.search(Store.query);
        }
    }

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 8px;
        spacing: 12px;

        // Account.
        HorizontalLayout {
            spacing: 8px;
            MaterialText {
                horizontal-stretch: 1;
                text: Store.account-name != "" ? @tr("已登录：{}", Store.account-name) : @tr("已登录 {}", Store.provider-name);
                style: MaterialTypography.body-medium;
                color: MaterialPalette.on-surface-variant;
                vertical-alignment: center;
                overflow: elide;
            }
            TextButton {
                horizontal-stretch: 0;
                text: @tr("退出登录");
                enabled: !(Store.transfer.state == "preparing" || Store.transfer.state == "downloading" || Store.transfer.state == "verifying" || Store.transfer.state == "cancelling");
                clicked => { Store.logout(); }
            }
        }

        TextField {
            label: @tr("搜索已拥有的游戏");
            leading-icon: Icons.search;
            trailing-icon: Store.query != "" ? Icons.close : @image-url("");
            text <=> Store.query;
            edited => { debounce.restart(); }
            accepted => {
                debounce.running = false;
                Store.search(Store.query);
            }
            trailing-icon-clicked => { root.clear-search(); }
        }

        if root.show-transfer : TransferPanel {
            transfer: Store.transfer;
            show-name: true;
        }

        Rectangle {
            vertical-stretch: 1;

            list := ScrollView {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                visible: Store.games.length > 0;

                VerticalLayout {
                    width: list.visible-width;
                    padding-bottom: 24px;
                    spacing: 2px;
                    alignment: start;

                    for game in Store.games : StoreGameRow {
                        game: game;
                        selected: game.title-id == Store.selected-title-id;
                        activate => { root.chosen(game.title-id); }
                    }
                }
            }

            if Store.games.length == 0 : VerticalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                alignment: center;
                padding-bottom: 48px;

                if Store.library-state == "loading" || Store.library-state == "idle" : StateMessage {
                    busy: true;
                    title: @tr("加载游戏库");
                    body: Store.status;
                }
                if Store.library-state == "error" : StateMessage {
                    icon: Icons.error;
                    error: true;
                    title: @tr("游戏库加载失败");
                    body: Store.error;
                    HorizontalLayout {
                        alignment: center;
                        OutlineButton {
                            icon: Icons.refresh;
                            text: @tr("重试");
                            clicked => { Store.refresh-library(); }
                        }
                    }
                }
                if Store.library-state == "ready" && Store.query != "" : StateMessage {
                    icon: Icons.search;
                    title: @tr("没有找到“{}”", Store.query);
                    body: @tr("换个关键词试试。");
                    HorizontalLayout {
                        alignment: center;
                        OutlineButton {
                            text: @tr("清除搜索");
                            clicked => { root.clear-search(); }
                        }
                    }
                }
                if Store.library-state == "ready" && Store.query == "" : StateMessage {
                    icon: Icons.library-books;
                    title: @tr("这个账户还没有游戏");
                    body: @tr("在商店购买或领取游戏后，刷新即可看到。");
                    HorizontalLayout {
                        alignment: center;
                        OutlineButton {
                            icon: Icons.refresh;
                            text: @tr("刷新");
                            clicked => { Store.refresh-library(); }
                        }
                    }
                }
            }

            // A refresh failure keeps the old list; say so above it.
            if Store.games.length > 0 && Store.library-state == "error" && Store.error != "" : ErrorBanner {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: self.preferred-height;
                text: Store.error;
            }
        }
    }
}

// Store 下载: login, then the owned-games master-detail view. Phones and
// medium widths show the selected game as a full-screen sheet.
export component StorePage {
    in property <bool> compact;

    property <length> bar-height: 64px;
    property <length> picker-height: Store.providers.length > 1 ? 80px : 0px;
    property <length> content-top: root.bar-height + root.picker-height;
    property <bool> signed-in: Store.login-state == "signed-in";
    property <bool> two-pane: root.width >= 760px;
    property <length> list-width: clamp(root.width * 0.4, 320px, 440px);
    property <bool> has-selection: Store.selected.title-id != "";
    property <bool> sheet-open: root.signed-in && !root.two-pane && Store.detail-open && root.has-selection;
    // Widening a phone sheet into master-detail drops its back-stack level.
    changed two-pane => {
        if root.two-pane {
            Store.detail-open = false;
        }
    }

    function choose(title-id: string) {
        Store.selected-title-id = title-id;
        Store.select-game(title-id);
        // Only the phone sheet is a separate back-stack level.
        Store.detail-open = !root.two-pane;
    }

    Rectangle {
        background: MaterialPalette.surface;
    }
    SmallAppBar {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.bar-height;
        title: Store.provider-name != "" ? @tr("{} 下载", Store.provider-name) : @tr("商店下载");
        leading-button: { icon: Icons.arrow-back, tooltip: @tr("返回添加游戏"), enabled: true };
        leading-button-clicked => { App.page = "add-game"; }
        trailing-buttons: root.signed-in ? [{ icon: Icons.refresh, tooltip: @tr("刷新游戏库"), enabled: Store.library-state != "loading" }] : [];
        trailing-button-clicked(index) => { Store.refresh-library(); }
    }

    if Store.providers.length > 1 : HorizontalLayout {
        x: 16px;
        y: root.bar-height + 8px;
        width: root.width - 32px;
        height: root.picker-height - 16px;
        ChoiceSelect {
            label: @tr("商店");
            choices: Store.providers;
            value: Store.provider-id;
            enabled: (Store.login-state == "signed-out" || Store.login-state == "signed-in" || Store.login-state == "error") && !(Store.transfer.state == "preparing" || Store.transfer.state == "downloading" || Store.transfer.state == "verifying" || Store.transfer.state == "cancelling");
            selected(id) => { Store.detail-open = false; Store.select-provider(id); }
        }
    }


    if !root.signed-in : StoreLogin {
        x: 0px;
        y: root.content-top;
        width: root.width;
        height: root.height - root.content-top;
        compact: root.compact;
    }

    if root.signed-in : StoreLibrary {
        x: 0px;
        y: root.content-top;
        width: root.two-pane ? root.list-width : root.width;
        height: root.height - root.content-top;
        show-transfer: Store.transfer.state != "idle" && (!root.two-pane || Store.transfer.title-id != Store.selected.title-id);
        chosen(title-id) => { root.choose(title-id); }
    }

    if root.signed-in && root.two-pane : Rectangle {
        x: root.list-width;
        y: root.content-top;
        width: 1px;
        height: root.height - root.content-top;
        background: MaterialPalette.outline-variant;
    }

    if root.signed-in && root.two-pane && root.has-selection : StoreDetail {
        x: root.list-width + 1px;
        y: root.content-top;
        width: root.width - root.list-width - 1px;
        height: root.height - root.content-top;
    }

    if root.signed-in && root.two-pane && !root.has-selection : StateMessage {
        x: root.list-width + 1px;
        y: root.content-top;
        width: root.width - root.list-width - 1px;
        height: root.height - root.content-top;
        icon: Icons.download;
        title: @tr("选择一款游戏");
        body: @tr("选择内容仓库、语言和分支后即可下载。");
    }

    if root.sheet-open : StoreDetail {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        sheet: true;
        close => { Store.detail-open = false; }
    }
}
