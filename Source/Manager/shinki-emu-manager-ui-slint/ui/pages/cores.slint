import { MaterialPalette, MaterialText, MaterialTypography, TextButton, FilledButton, OutlineButton, TonalButton, HorizontalDivider, Icon, SmallAppBar, LinearProgressIndicator } from "@material";
import { App, Cores, CoreInfo, Network } from "../globals.slint";
import { Icons } from "../icons.slint";
import { ConfigFieldList } from "../components/config-field.slint";
import { RenderPicker } from "../components/render-picker.slint";
import { PageScroll, SettingGroup, StatusChip } from "./settings/common.slint";

export global CoreText {
    public pure function state-label(core: CoreInfo) -> string {
        return core.state == "loaded" ? (core.update-version != "" ? @tr("可更新") : @tr("已加载"))
            : core.state == "installed" ? (core.update-version != "" ? @tr("可更新") : @tr("已安装，尚未加载"))
            : core.state == "failed" ? @tr("加载失败")
            : core.state == "pending-install" ? @tr("重启后安装")
            : core.state == "pending-update" ? @tr("重启后更新")
            : core.state == "pending-removal" ? @tr("重启后移除")
            : core.state == "available" ? @tr("可安装")
            : core.state;
    }

    public pure function source-label(source: string) -> string {
        return source == "bundled" ? @tr("随附") : source == "user" ? @tr("用户安装") : source == "online" ? @tr("在线") : source;
    }

    public pure function is-pending(state: string) -> bool {
        return state == "pending-install" || state == "pending-update" || state == "pending-removal";
    }

    public pure function is-downloading(core: CoreInfo) -> bool {
        return core.download-phase == "queued" || core.download-phase == "downloading"
            || core.download-phase == "verifying" || core.download-phase == "installing";
    }

    public pure function download-label(core: CoreInfo) -> string {
        return core.download-phase == "queued" ? @tr("排队中")
            : core.download-phase == "downloading" ? @tr("正在下载")
            : core.download-phase == "verifying" ? @tr("正在校验")
            : core.download-phase == "installing" ? @tr("正在安装")
            : core.download-phase == "failed" ? @tr("下载失败")
            : "";
    }
}

component CoreRow {
    in property <CoreInfo> core;
    in property <bool> editing;
    callback edit-defaults();

    property <bool> failed: root.core.state == "failed";
    property <bool> update: (root.core.state == "loaded" || root.core.state == "installed") && root.core.update-version != "";
    property <bool> downloading: CoreText.is-downloading(root.core);
    property <bool> download-failed: root.core.download-phase == "failed";
    property <bool> determinate: root.core.download-phase == "downloading" && root.core.download-progress >= 0;

    min-height: l.min-height;
    preferred-height: l.preferred-height;

    l := VerticalLayout {
        padding-left: 16px;
        padding-right: 8px;
        padding-top: 12px;
        padding-bottom: 4px;
        spacing: 4px;

        HorizontalLayout {
            padding-right: 8px;
            spacing: 12px;

            VerticalLayout {
                alignment: start;
                horizontal-stretch: 0;
                padding-top: 2px;
                Icon {
                    width: 24px;
                    height: 24px;
                    source: root.failed ? Icons.error : Icons.memory;
                    colorize: root.failed ? MaterialPalette.error : MaterialPalette.primary;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                MaterialText {
                    text: root.core.name != "" ? root.core.name : root.core.id;
                    style: MaterialTypography.title-medium;
                    color: MaterialPalette.on-surface;
                    overflow: elide;
                }
                // Each part stays whole; a part that no longer fits moves to the next line.
                FlexboxLayout {
                    spacing: 6px;
                    if root.core.engine != "" : MaterialText {
                        min-width: self.preferred-width;
                        text: root.core.engine + " ·";
                        style: MaterialTypography.body-medium;
                        color: MaterialPalette.on-surface-variant;
                    }
                    MaterialText {
                        min-width: self.preferred-width;
                        text: root.core.version != "" ? root.core.version : @tr("版本未知");
                        style: MaterialTypography.body-medium;
                        color: MaterialPalette.on-surface-variant;
                    }
                    if root.update : MaterialText {
                        min-width: self.preferred-width;
                        text: "→ " + root.core.update-version;
                        style: MaterialTypography.body-medium;
                        color: MaterialPalette.on-surface-variant;
                    }
                    if root.core.source != "" : MaterialText {
                        min-width: self.preferred-width;
                        text: "· " + CoreText.source-label(root.core.source);
                        style: MaterialTypography.body-medium;
                        color: MaterialPalette.on-surface-variant;
                    }
                }
            }

            VerticalLayout {
                alignment: start;
                horizontal-stretch: 0;
                padding-top: 2px;
                StatusChip {
                    text: root.downloading || root.download-failed ? CoreText.download-label(root.core) : CoreText.state-label(root.core);
                    background: root.failed || root.download-failed ? MaterialPalette.error-container
                        : root.downloading ? MaterialPalette.secondary-container
                        : root.update ? MaterialPalette.tertiary-container
                        : CoreText.is-pending(root.core.state) ? MaterialPalette.secondary-container
                        : root.core.state == "available" ? MaterialPalette.surface-container-highest
                        : MaterialPalette.primary-container;
                    foreground: root.failed || root.download-failed ? MaterialPalette.on-error-container
                        : root.downloading ? MaterialPalette.on-secondary-container
                        : root.update ? MaterialPalette.on-tertiary-container
                        : CoreText.is-pending(root.core.state) ? MaterialPalette.on-secondary-container
                        : root.core.state == "available" ? MaterialPalette.on-surface-variant
                        : MaterialPalette.on-primary-container;
                }
            }
        }

        if root.core.message != "" : HorizontalLayout {
            padding-left: 36px;
            padding-right: 8px;
            MaterialText {
                text: root.core.message;
                style: MaterialTypography.body-small;
                color: root.failed ? MaterialPalette.error : MaterialPalette.on-surface-variant;
                wrap: word-wrap;
                overflow: clip;
            }
        }

        if root.downloading : VerticalLayout {
            padding-left: 36px;
            padding-right: 8px;
            padding-top: 4px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                MaterialText {
                    horizontal-stretch: 1;
                    text: root.core.download-phase == "downloading"
                        ? (root.core.download-bytes != "" ? root.core.download-bytes : @tr("正在连接…"))
                            + (root.core.download-speed != "" ? " · " + root.core.download-speed : "")
                        : root.core.download-phase == "queued" ? @tr("等待其他核心下载完成")
                        : root.core.download-phase == "verifying" ? @tr("正在核对文件大小和 SHA-256")
                        : @tr("正在写入待安装区，重启后生效");
                    style: MaterialTypography.body-small;
                    color: MaterialPalette.on-surface-variant;
                    wrap: word-wrap;
                    overflow: clip;
                }
                if root.determinate : MaterialText {
                    horizontal-stretch: 0;
                    text: round(root.core.download-progress * 100) + "%";
                    style: MaterialTypography.label-medium;
                    color: MaterialPalette.on-surface;
                }
            }
            LinearProgressIndicator {
                indeterminate: !root.determinate;
                progress: root.determinate ? root.core.download-progress : 0;
                accessible-label: CoreText.download-label(root.core);
            }
        }

        if root.download-failed : HorizontalLayout {
            padding-left: 36px;
            padding-right: 8px;
            MaterialText {
                text: @tr("下载失败：{}", root.core.download-error);
                style: MaterialTypography.body-small;
                color: MaterialPalette.error;
                wrap: word-wrap;
                overflow: clip;
            }
        }

        if root.core.capabilities.length > 0 : HorizontalLayout {
            padding-left: 36px;
            padding-top: 4px;
            FlexboxLayout {
                spacing: 6px;
                for cap in root.core.capabilities : StatusChip {
                    text: cap;
                    background: MaterialPalette.surface-container-highest;
                    foreground: MaterialPalette.on-surface-variant;
                }
            }
        }

        HorizontalLayout {
            padding-left: 28px;
            FlexboxLayout {
                horizontal-stretch: 1;
                spacing: 0px;
                if root.update && !root.downloading : TextButton {
                    text: root.download-failed ? @tr("重试") : @tr("更新到 {}", root.core.update-version);
                    icon: root.download-failed ? Icons.refresh : Icons.download;
                    enabled: Network.allowed;
                    clicked => { Cores.install-online(root.core.id); }
                }
                if root.core.state == "available" && !root.downloading : TextButton {
                    text: root.download-failed ? @tr("重试") : @tr("安装");
                    icon: root.download-failed ? Icons.refresh : Icons.download;
                    enabled: Network.allowed;
                    clicked => { Cores.install-online(root.core.id); }
                }
                if root.downloading && root.core.download-phase != "installing" : TextButton {
                    text: @tr("取消");
                    icon: Icons.close;
                    clicked => { Cores.cancel-download(root.core.id); }
                }
                if root.core.state == "loaded" : TextButton {
                    text: root.editing ? @tr("收起默认设置") : @tr("默认设置");
                    icon: root.editing ? Icons.expand-less : Icons.tune;
                    accessible-expandable: true;
                    accessible-expanded: root.editing;
                    clicked => { root.edit-defaults(); }
                }
                if root.core.state == "loaded" || root.failed : TextButton {
                    text: @tr("查看日志");
                    clicked => { Cores.view-logs(root.core.id); }
                }
                if root.core.removable && (root.core.state == "loaded" || root.core.state == "installed" || root.failed) : TextButton {
                    text: @tr("卸载");
                    icon: Icons.delete;
                    clicked => { Cores.uninstall(root.core.id); }
                }
            }
        }
    }
}

component DefaultsEditor {
    min-height: l.min-height;
    preferred-height: l.preferred-height;

    l := VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 8px;
        padding-bottom: 16px;

        Rectangle {
            border-radius: 12px;
            background: MaterialPalette.surface-container;

            VerticalLayout {
                padding: 16px;
                spacing: 16px;

                VerticalLayout {
                    spacing: 4px;
                    MaterialText {
                        text: @tr("模拟器默认设置");
                        style: MaterialTypography.title-small;
                        color: MaterialPalette.primary;
                    }
                    MaterialText {
                        text: @tr("没有单独设置的游戏使用这里的值；修改立即保存。");
                        style: MaterialTypography.body-small;
                        color: MaterialPalette.on-surface-variant;
                        wrap: word-wrap;
                        overflow: clip;
                    }
                }

                RenderPicker {
                    supported: Cores.default-render.supported;
                    options: Cores.default-render.options;
                    mode: Cores.default-render.mode;
                    custom-width: Cores.default-render.custom-width;
                    custom-height: Cores.default-render.custom-height;
                    min: Cores.default-render.min;
                    max: Cores.default-render.max;
                    note: Cores.default-render.note;
                    error: Cores.default-render.error;
                    set-render(mode, w, h) => { Cores.set-default-render(mode, w, h); }
                }

                if Cores.default-fields.length == 0 : MaterialText {
                    text: @tr("这个模拟器没有其他可调参数。");
                    style: MaterialTypography.body-medium;
                    color: MaterialPalette.on-surface-variant;
                }

                if Cores.default-fields.length > 0 : ConfigFieldList {
                    fields: Cores.default-fields;
                    changed(key, value) => { Cores.default-field-changed(key, value); }
                    reset(key) => { Cores.reset-default-field(key); }
                }
            }
        }
    }
}

component GroupCounter {
    in property <string> group;
    out property <int> count: round(l.preferred-height / 1px);

    x: 0px;
    y: 0px;
    width: 0px;
    height: 0px;
    visible: false;

    l := VerticalLayout {
        for core in Cores.items : Rectangle {
            height: (root.group == "installed" && (core.state == "loaded" || core.state == "installed"))
                || (root.group == "available" && core.state == "available")
                || (root.group == "failed" && core.state == "failed")
                || (root.group == "pending" && CoreText.is-pending(core.state)) ? 1px : 0px;
        }
    }
}

component CoreGroup inherits SettingGroup {
    in property <string> group;
    flush: true;

    for core in Cores.items : VerticalLayout {
        if (root.group == "installed" && (core.state == "loaded" || core.state == "installed"))
            || (root.group == "available" && core.state == "available")
            || (root.group == "failed" && core.state == "failed")
            || (root.group == "pending" && CoreText.is-pending(core.state)) : VerticalLayout {
            CoreRow {
                core: core;
                editing: Cores.default-plugin == core.id;
                edit-defaults => {
                    if Cores.default-plugin == core.id {
                        Cores.default-plugin = "";
                        Cores.select-defaults("");
                    } else {
                        Cores.select-defaults(core.id);
                    }
                }
            }
            if Cores.default-plugin == core.id && core.state == "loaded" : DefaultsEditor { }
        }
    }
}

component HeaderActions {
    property <bool> can-update-all: Cores.update-all-count > 0 && Cores.batch.state != "running";

    min-width: f.min-width;
    preferred-width: f.preferred-width;
    min-height: f.min-height;
    preferred-height: f.preferred-height;

    f := FlexboxLayout {
        spacing: 8px;
        if root.can-update-all : FilledButton {
            text: @tr("全部更新（{}）", Cores.update-all-count);
            icon: Icons.download;
            enabled: Network.allowed;
            clicked => { Cores.update-all(); }
        }
        OutlineButton {
            text: @tr("从本地安装…");
            icon: Icons.upload-file;
            clicked => { Cores.install-local(); }
        }
    }
}

// Progress of a 全部更新 run, then its outcome until dismissed.
component BatchCard {
    property <bool> running: Cores.batch.state == "running";
    property <int> done: Cores.batch.succeeded + Cores.batch.failed + Cores.batch.cancelled;
    property <bool> had-failures: Cores.batch.failed > 0;

    min-height: l.min-height;
    preferred-height: l.preferred-height;
    accessible-role: groupbox;

    Rectangle {
        border-radius: 16px;
        background: root.had-failures && !root.running ? MaterialPalette.error-container : MaterialPalette.secondary-container;
    }

    l := VerticalLayout {
        padding: 16px;
        padding-bottom: 8px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 16px;
            VerticalLayout {
                alignment: start;
                horizontal-stretch: 0;
                Icon {
                    width: 24px;
                    height: 24px;
                    source: root.running ? Icons.download : root.had-failures ? Icons.warning : Icons.check;
                    colorize: root.had-failures && !root.running ? MaterialPalette.on-error-container : MaterialPalette.on-secondary-container;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                MaterialText {
                    text: root.running ? @tr("正在更新核心") : root.had-failures ? @tr("部分核心更新失败") : @tr("核心更新完成");
                    style: MaterialTypography.title-small;
                    color: root.had-failures && !root.running ? MaterialPalette.on-error-container : MaterialPalette.on-secondary-container;
                    wrap: word-wrap;
                    overflow: clip;
                }
                MaterialText {
                    text: root.running
                        ? @tr("已完成 {0}/{1}", root.done, Cores.batch.total)
                        : @tr("成功 {0} 个，失败 {1} 个", Cores.batch.succeeded, Cores.batch.failed)
                            + (Cores.batch.cancelled > 0 ? @tr("，取消 {} 个", Cores.batch.cancelled) : "");
                    style: MaterialTypography.body-medium;
                    color: root.had-failures && !root.running ? MaterialPalette.on-error-container : MaterialPalette.on-secondary-container;
                    wrap: word-wrap;
                    overflow: clip;
                }
            }
        }

        if root.running : LinearProgressIndicator {
            progress: Cores.batch.progress;
            accessible-label: @tr("正在更新核心");
        }

        HorizontalLayout {
            alignment: end;
            spacing: 4px;
            if root.running : TextButton {
                text: @tr("全部取消");
                clicked => { Cores.cancel-all(); }
            }
            if !root.running && root.had-failures : TonalButton {
                text: @tr("重试失败项（{}）", Cores.batch.failed);
                icon: Icons.refresh;
                enabled: Network.allowed;
                clicked => { Cores.retry-failed(); }
            }
            if !root.running : TextButton {
                text: @tr("关闭");
                clicked => { Cores.dismiss-batch(); }
            }
        }
    }
}

// Top-level 核心 page: app bar plus one scrolling column.
export component CoresPage {
    in property <bool> compact;
    property <length> bar-height: 64px;
    // Narrow pages put the header buttons under the description.
    property <bool> narrow: root.width < 640px;

    installed := GroupCounter { group: "installed"; }
    available := GroupCounter { group: "available"; }
    failed := GroupCounter { group: "failed"; }
    pending := GroupCounter { group: "pending"; }

    Rectangle {
        background: MaterialPalette.surface;
    }

    SmallAppBar {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.bar-height;
        title: @tr("核心");
        leading-button: root.compact ? { icon: Icons.arrow-back, tooltip: @tr("返回游戏库"), enabled: true } : { };
        leading-button-clicked => { App.page = "library"; }
    }

    PageScroll {
        x: 0px;
        y: root.bar-height;
        width: root.width;
        height: root.height - root.bar-height;

        if Cores.restart-required : Rectangle {
            border-radius: 16px;
            background: MaterialPalette.tertiary-container;

            // Narrow pages put 立即重启 under the message.
            VerticalLayout {
                padding: 16px;
                padding-bottom: root.narrow ? 12px : 16px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 16px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        Icon {
                            width: 24px;
                            height: 24px;
                            source: Icons.restart-alt;
                            colorize: MaterialPalette.on-tertiary-container;
                        }
                    }
                    MaterialText {
                        horizontal-stretch: 1;
                        text: @tr("核心有变更，重启 ShinkiEMU 后生效。");
                        style: MaterialTypography.body-large;
                        color: MaterialPalette.on-tertiary-container;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        overflow: clip;
                    }
                    if !root.narrow : VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        FilledButton {
                            text: @tr("立即重启");
                            clicked => { Cores.restart(); }
                        }
                    }
                }
                if root.narrow : HorizontalLayout {
                    alignment: end;
                    FilledButton {
                        text: @tr("立即重启");
                        clicked => { Cores.restart(); }
                    }
                }
            }
        }

        if Cores.batch.state != "" : BatchCard { }

        if !root.narrow : HorizontalLayout {
            spacing: 12px;
            MaterialText {
                horizontal-stretch: 1;
                text: Network.allowed ? @tr("在线核心列表来自 ShinkiEMU 元数据，下载后重启生效。") : @tr("允许联网后可以在线安装和更新核心。");
                style: MaterialTypography.body-medium;
                color: MaterialPalette.on-surface-variant;
                vertical-alignment: center;
                wrap: word-wrap;
                overflow: clip;
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                HeaderActions { }
            }
        }

        if root.narrow : VerticalLayout {
            spacing: 8px;
            MaterialText {
                text: Network.allowed ? @tr("在线核心列表来自 ShinkiEMU 元数据，下载后重启生效。") : @tr("允许联网后可以在线安装和更新核心。");
                style: MaterialTypography.body-medium;
                color: MaterialPalette.on-surface-variant;
                wrap: word-wrap;
                overflow: clip;
            }
            HeaderActions { }
        }

        if Cores.items.length == 0 : SettingGroup {
            MaterialText {
                text: @tr("没有找到核心。可以从本地安装核心包，或允许联网后在线安装。");
                style: MaterialTypography.body-medium;
                color: MaterialPalette.on-surface-variant;
                wrap: word-wrap;
                overflow: clip;
            }
        }

        if pending.count > 0 : CoreGroup {
            title: @tr("待重启（{}）", pending.count);
            group: "pending";
        }
        if failed.count > 0 : CoreGroup {
            title: @tr("加载失败（{}）", failed.count);
            group: "failed";
        }
        if installed.count > 0 : CoreGroup {
            title: @tr("已安装（{}）", installed.count);
            group: "installed";
        }
        if available.count > 0 : CoreGroup {
            title: @tr("可安装（{}）", available.count);
            group: "available";
        }
    }
}
