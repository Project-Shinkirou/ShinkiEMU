import { App, Appearance } from "../../globals.slint";
import { Segments } from "../../components/segments.slint";
import { PageScroll, SettingGroup, SwitchRow, FieldBlock } from "./common.slint";

export global AppearanceEdit {
    public function commit(next: Appearance) {
        App.appearance = next;
        App.appearance-changed(next);
    }

    public function set-theme(mode: string) {
        let a = App.appearance;
        self.commit({ theme-mode: mode, density: a.density, cover-size: a.cover-size, view-mode: a.view-mode, reduce-motion: a.reduce-motion, cover-badges: a.cover-badges, language: a.language });
    }

    public function set-density(density: string) {
        let a = App.appearance;
        self.commit({ theme-mode: a.theme-mode, density: density, cover-size: a.cover-size, view-mode: a.view-mode, reduce-motion: a.reduce-motion, cover-badges: a.cover-badges, language: a.language });
    }

    public function set-cover-size(size: string) {
        let a = App.appearance;
        self.commit({ theme-mode: a.theme-mode, density: a.density, cover-size: size, view-mode: a.view-mode, reduce-motion: a.reduce-motion, cover-badges: a.cover-badges, language: a.language });
    }

    public function set-view-mode(mode: string) {
        let a = App.appearance;
        self.commit({ theme-mode: a.theme-mode, density: a.density, cover-size: a.cover-size, view-mode: mode, reduce-motion: a.reduce-motion, cover-badges: a.cover-badges, language: a.language });
    }

    public function set-reduce-motion(on: bool) {
        let a = App.appearance;
        self.commit({ theme-mode: a.theme-mode, density: a.density, cover-size: a.cover-size, view-mode: a.view-mode, reduce-motion: on, cover-badges: a.cover-badges, language: a.language });
    }

    public function set-language(language: string) {
        let a = App.appearance;
        self.commit({ theme-mode: a.theme-mode, density: a.density, cover-size: a.cover-size, view-mode: a.view-mode, reduce-motion: a.reduce-motion, cover-badges: a.cover-badges, language: language });
    }

    public function set-cover-badges(on: bool) {
        let a = App.appearance;
        self.commit({ theme-mode: a.theme-mode, density: a.density, cover-size: a.cover-size, view-mode: a.view-mode, reduce-motion: a.reduce-motion, cover-badges: on, language: a.language });
    }
}

export component ThemeChooser inherits FieldBlock {
    label: @tr("主题");
    Segments {
        label: @tr("主题");
        items: [@tr("跟随系统"), @tr("浅色"), @tr("深色")];
        index: App.appearance.theme-mode == "light" ? 1 : App.appearance.theme-mode == "dark" ? 2 : 0;
        selected(i) => { AppearanceEdit.set-theme(i == 1 ? "light" : i == 2 ? "dark" : "system"); }
    }
}

// Language names stay in their own script so each is findable in any UI language.
export component LanguageChooser inherits FieldBlock {
    label: @tr("语言");
    Segments {
        label: @tr("语言");
        items: [@tr("跟随系统"), "简体中文", "English", "日本語"];
        index: App.appearance.language == "zh-CN" ? 1 : App.appearance.language == "en" ? 2 : App.appearance.language == "ja" ? 3 : 0;
        selected(i) => { AppearanceEdit.set-language(i == 1 ? "zh-CN" : i == 2 ? "en" : i == 3 ? "ja" : "system"); }
    }
}

export component CoverSizeChooser inherits FieldBlock {
    label: @tr("封面大小");
    Segments {
        label: @tr("封面大小");
        items: [@tr("大"), @tr("中"), @tr("小")];
        index: App.appearance.cover-size == "large" ? 0 : App.appearance.cover-size == "small" ? 2 : 1;
        selected(i) => { AppearanceEdit.set-cover-size(i == 0 ? "large" : i == 2 ? "small" : "medium"); }
    }
}

export component AppearanceSection inherits PageScroll {
    title: @tr("外观");

    SettingGroup {
        title: @tr("显示");

        ThemeChooser { }

        LanguageChooser { }

        FieldBlock {
            label: @tr("密度");
            description: @tr("紧凑模式会缩小间距和封面。");
            Segments {
                label: @tr("密度");
                items: [@tr("舒适"), @tr("紧凑")];
                index: App.appearance.density == "compact" ? 1 : 0;
                selected(i) => { AppearanceEdit.set-density(i == 1 ? "compact" : "comfortable"); }
            }
        }

        CoverSizeChooser { }

        FieldBlock {
            label: @tr("游戏库视图");
            Segments {
                label: @tr("游戏库视图");
                items: [@tr("网格"), @tr("列表")];
                index: App.appearance.view-mode == "list" ? 1 : 0;
                selected(i) => { AppearanceEdit.set-view-mode(i == 1 ? "list" : "grid"); }
            }
        }
    }

    SettingGroup {
        title: @tr("细节");

        SwitchRow {
            label: @tr("减少动态效果");
            description: @tr("关闭界面过渡动画。");
            value: App.appearance.reduce-motion;
            toggled(on) => { AppearanceEdit.set-reduce-motion(on); }
        }

        SwitchRow {
            label: @tr("封面兼容性徽章");
            description: @tr("在游戏封面上显示兼容性状态。");
            value: App.appearance.cover-badges;
            toggled(on) => { AppearanceEdit.set-cover-badges(on); }
        }
    }
}
