import { MaterialPalette, MaterialText, MaterialTypography, Icon, HorizontalDivider, StateLayerArea } from "@material";
import { AboutSlint } from "std-widgets.slint";
import { App, Onboarding, ResaleNoticeState } from "../../globals.slint";
import { Icons } from "../../icons.slint";
import { PageScroll, SettingGroup } from "./common.slint";
import { DisclaimerText } from "../../components/disclaimer.slint";
import { ResaleNoticeSlot } from "../../components/resale-notice.slint";

component LinkRow {
    in property <string> text;
    in property <string> supporting-text;
    in property <image> icon;
    callback clicked();

    min-height: 64px;
    preferred-height: 64px;
    forward-focus: area;
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.supporting-text;
    accessible-action-default => { root.clicked(); }

    // StateLayerArea maps Enter/Space to clicked and draws hover/focus/press layers.
    area := StateLayerArea {
        width: root.width;
        height: root.height;
        color: MaterialPalette.on-surface;
        clicked => { root.clicked(); }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 16px;

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                Icon {
                    width: 24px;
                    height: 24px;
                    source: root.icon;
                    colorize: MaterialPalette.on-surface-variant;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                MaterialText {
                    text: root.text;
                    style: MaterialTypography.body-large;
                    color: MaterialPalette.on-surface;
                }
                MaterialText {
                    text: root.supporting-text;
                    style: MaterialTypography.body-medium;
                    color: MaterialPalette.on-surface-variant;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                Icon {
                    width: 24px;
                    height: 24px;
                    source: Icons.chevron-right;
                    colorize: MaterialPalette.on-surface-variant;
                }
            }
        }
    }
}

export component AboutSection inherits PageScroll {
    title: @tr("关于");

    property <{x: length, y: length, width: length, height: length}> viewport: {
        x: root.viewport-x,
        y: root.viewport-y,
        width: root.viewport-width,
        height: root.viewport-height,
    };

    function report-viewport() {
        ResaleNoticeState.report-about-clip(root.viewport.x, root.viewport.y, root.viewport.width, root.viewport.height);
    }

    init => { root.report-viewport(); }
    changed viewport => { root.report-viewport(); }

    SettingGroup {
        HorizontalLayout {
            spacing: 16px;
            Rectangle {
                width: 56px;
                height: 56px;
                border-radius: 16px;
                background: MaterialPalette.primary-container;
                Icon {
                    width: 32px;
                    height: 32px;
                    source: Icons.sports-esports;
                    colorize: MaterialPalette.on-primary-container;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                MaterialText {
                    text: "ShinkiEMU";
                    style: MaterialTypography.title-large;
                    color: MaterialPalette.on-surface;
                }
                MaterialText {
                    text: App.build != ""
                        ? @tr("版本 {0} · 构建 {1}", App.version != "" ? App.version : @tr("未知"), App.build)
                        : @tr("版本 {}", App.version != "" ? App.version : @tr("未知"));
                    style: MaterialTypography.body-medium;
                    color: MaterialPalette.on-surface-variant;
                    wrap: word-wrap;
                    overflow: clip;
                }
            }
        }
    }

    // Rust-rasterized notice, with the same title style as SettingGroup.
    VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            MaterialText {
                text: @tr("防倒卖声明");
                style: MaterialTypography.title-small;
                color: MaterialPalette.primary;
            }
        }
        ResaleNoticeSlot {
            about: true;
            wide: root.width >= 600px;
        }
    }

    SettingGroup {
        title: @tr("免责声明");
        DisclaimerText { }
    }

    SettingGroup {
        flush: true;

        LinkRow {
            text: @tr("第三方许可");
            supporting-text: @tr("ShinkiEMU 使用的开源组件及其许可证");
            icon: Icons.info;
            clicked => { App.open-path("third-party-notices"); }
        }
        HorizontalDivider { }
        LinkRow {
            text: @tr("打开数据目录");
            supporting-text: @tr("资料库、设置、封面缓存和用户安装的核心");
            icon: Icons.folder-open;
            clicked => { App.open-path("data"); }
        }
        HorizontalDivider { }
        LinkRow {
            text: @tr("打开日志目录");
            supporting-text: @tr("报告问题时请附上日志");
            icon: Icons.history;
            clicked => { App.open-path("logs"); }
        }
        HorizontalDivider { }
        LinkRow {
            text: @tr("重新运行首次设置");
            supporting-text: @tr("重新查看说明，选择库目录、联网与外观");
            icon: Icons.restart-alt;
            clicked => {
                Onboarding.step = 0;
                App.page = "onboarding";
            }
        }
    }

    SettingGroup {
        title: @tr("界面框架");
        HorizontalLayout {
            alignment: center;
            AboutSlint {
                preferred-width: 360px;
            }
        }
    }
}
