import { MaterialPalette, MaterialText, MaterialTypography, Icon, HorizontalDivider, StateLayerArea } from "@material";
import { AboutSlint } from "std-widgets.slint";
import { App, Onboarding } from "../../globals.slint";
import { Icons } from "../../icons.slint";
import { PageScroll, SettingGroup } from "./common.slint";

component LinkRow {
    in property <string> text;
    in property <string> supporting-text;
    in property <bool> wrap-labels;
    in property <image> icon;
    callback clicked();

    min-height: root.wrap-labels ? max(64px, labels.min-height + 16px) : 64px;
    preferred-height: root.wrap-labels ? max(64px, labels.preferred-height + 16px) : 64px;
    forward-focus: area;
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.supporting-text;
    accessible-action-default => { root.clicked(); }

    // StateLayerArea maps Enter/Space to clicked and draws hover/focus/press layers.
    area := StateLayerArea {
        width: root.width;
        height: root.height;
        color: MaterialPalette.on-surface;
        clicked => { root.clicked(); }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 16px;

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                Icon {
                    width: 24px;
                    height: 24px;
                    source: root.icon;
                    colorize: MaterialPalette.on-surface-variant;
                }
            }
            labels := VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                MaterialText {
                    text: root.text;
                    style: MaterialTypography.body-large;
                    color: MaterialPalette.on-surface;
                    wrap: root.wrap-labels ? word-wrap : no-wrap;
                    overflow: root.wrap-labels ? clip : elide;
                }
                MaterialText {
                    text: root.supporting-text;
                    style: MaterialTypography.body-medium;
                    color: MaterialPalette.on-surface-variant;
                    wrap: root.wrap-labels ? word-wrap : no-wrap;
                    overflow: root.wrap-labels ? clip : elide;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                Icon {
                    width: 24px;
                    height: 24px;
                    source: Icons.chevron-right;
                    colorize: MaterialPalette.on-surface-variant;
                }
            }
        }
    }
}

export component AboutSection inherits PageScroll {
    title: @tr("关于");

    SettingGroup {
        HorizontalLayout {
            spacing: 16px;
            Rectangle {
                width: 56px;
                height: 56px;
                border-radius: 16px;
                background: MaterialPalette.primary-container;
                Icon {
                    width: 32px;
                    height: 32px;
                    source: Icons.sports-esports;
                    colorize: MaterialPalette.on-primary-container;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                MaterialText {
                    text: "ShinkiEMU";
                    style: MaterialTypography.title-large;
                    color: MaterialPalette.on-surface;
                }
                MaterialText {
                    text: App.build != ""
                        ? @tr("版本 {0} · 构建 {1}", App.version != "" ? App.version : @tr("未知"), App.build)
                        : @tr("版本 {}", App.version != "" ? App.version : @tr("未知"));
                    style: MaterialTypography.body-medium;
                    color: MaterialPalette.on-surface-variant;
                    wrap: word-wrap;
                    overflow: clip;
                }
            }
        }
    }

    SettingGroup {
        title: @tr("开源与版权");
        MaterialText {
            text: @tr("ShinkiEMU 免费开源。请从官网或 GitHub Releases 下载；如果付费购买了软件，请向卖家申请退款。");
            style: MaterialTypography.body-medium;
            wrap: word-wrap;
            overflow: clip;
        }
        MaterialText {
            text: @tr("请使用合法取得的游戏。游戏、引擎和商标归各自权利人所有。软件按开源许可证原样提供。");
            style: MaterialTypography.body-medium;
            wrap: word-wrap;
            overflow: clip;
        }
    }

    SettingGroup {
        flush: true;

        LinkRow {
            text: @tr("第三方许可");
            supporting-text: @tr("ShinkiEMU 使用的开源组件及其许可证");
            icon: Icons.info;
            clicked => { App.open-path("third-party-notices"); }
        }
        HorizontalDivider { }
        LinkRow {
            text: @tr("打开数据目录");
            supporting-text: @tr("资料库、设置、封面缓存和用户安装的核心");
            icon: Icons.folder-open;
            clicked => { App.open-path("data"); }
        }
        HorizontalDivider { }
        LinkRow {
            text: @tr("打开日志目录");
            supporting-text: @tr("报告问题时请附上日志");
            icon: Icons.history;
            clicked => { App.open-path("logs"); }
        }
        HorizontalDivider { }
        LinkRow {
            text: @tr("重新运行首次设置");
            supporting-text: @tr("选择库目录、联网与外观");
            icon: Icons.restart-alt;
            clicked => {
                Onboarding.step = 0;
                App.page = "onboarding";
            }
        }
    }

    SettingGroup {
        title: @tr("致谢");
        description: @tr("感谢上游核心开发者、项目社区，以及为 ShinkiEMU 适配和测试的贡献者。选择项目可在浏览器中查看贡献者。");
        flush: true;

        // Original repositories are listed in build/cores.toml. Author and
        // team credits come from upstream licenses and public contributor pages.
        for credit[index] in [
            { project: "Art3m1s Core", authors: "Alphaly2K", url: "https://github.com/Alphaly2K/art3m1s-core/graphs/contributors" },
            { project: "cmvs-rs", authors: "gkouen", url: "https://github.com/Shizuku-in/cmvs-rs/graphs/contributors" },
            { project: "ethornell-rs", authors: "xmoezzz", url: "https://github.com/xmoezzz/ethornell-rs/graphs/contributors" },
            { project: "impacto", authors: "Committee of Zero", url: "https://github.com/CommitteeOfZero/impacto/graphs/contributors" },
            { project: "Kirikiroid2 Web", authors: "fenghengzhi", url: "https://github.com/fenghengzhi/kirikiroid2-web/graphs/contributors" },
            { project: "KrKr2", authors: "2468785842", url: "https://github.com/2468785842/krkr2/graphs/contributors" },
            { project: "ReMinori", authors: "luoyily", url: "https://github.com/luoyily/ReMinori/graphs/contributors" },
            { project: "Ren’Py", authors: "Tom Rothamel", url: "https://github.com/renpy/renpy/graphs/contributors" },
            { project: "RFVP", authors: "xmoezzz", url: "https://github.com/xmoezzz/rfvp/graphs/contributors" },
            { project: "Siglus RS", authors: "xmoezzz", url: "https://github.com/xmoezzz/siglus_rs/graphs/contributors" },
            { project: "SoftPAL RS (Sena)", authors: "404-GCross, Alphaly2K, xmoezzz", url: "https://github.com/xmoezzz/sena-rs/graphs/contributors" },
        ] : VerticalLayout {
            if index > 0 : HorizontalDivider { }
            LinkRow {
                text: credit.project;
                supporting-text: @tr("{} 及项目贡献者", credit.authors);
                wrap-labels: true;
                icon: Icons.memory;
                clicked => { Platform.open-url(credit.url); }
            }
        }
        HorizontalDivider { }
        LinkRow {
            text: "Project Shinkirou";
            supporting-text: @tr("ShinkiEMU 适配与测试");
            wrap-labels: true;
            icon: Icons.build;
            clicked => { Platform.open-url("https://github.com/Project-Shinkirou/ShinkiEMU/graphs/contributors"); }
        }
        Rectangle { height: 20px; }
    }

    SettingGroup {
        title: @tr("界面框架");
        HorizontalLayout {
            alignment: center;
            AboutSlint {
                preferred-width: 360px;
            }
        }
    }
}
