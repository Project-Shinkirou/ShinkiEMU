import { MaterialPalette, MaterialText, MaterialTypography, Icon, TextButton, HorizontalDivider, StateLayerArea } from "@material";
import { AboutSlint, TextEdit } from "std-widgets.slint";
import { App, Onboarding } from "../../globals.slint";
import { Icons } from "../../icons.slint";
import { PageScroll, SettingGroup } from "./common.slint";

component LinkRow {
    in property <string> text;
    in property <string> supporting-text;
    in property <image> icon;
    callback clicked();

    height: 64px;
    forward-focus: area;
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.supporting-text;
    accessible-action-default => { root.clicked(); }

    // StateLayerArea maps Enter/Space to clicked and draws hover/focus/press layers.
    area := StateLayerArea {
        width: root.width;
        height: root.height;
        color: MaterialPalette.on-surface;
        clicked => { root.clicked(); }

        Icon {
            x: 16px;
            y: (root.height - self.height) / 2;
            width: 24px;
            height: 24px;
            source: root.icon;
            colorize: MaterialPalette.on-surface-variant;
        }
        VerticalLayout {
            x: 72px;
            y: (root.height - self.height) / 2;
            width: max(0px, root.width - 128px);
            height: self.preferred-height;
            spacing: 2px;
            MaterialText {
                text: root.text;
                style: MaterialTypography.body-large;
                color: MaterialPalette.on-surface;
                overflow: elide;
            }
            MaterialText {
                text: root.supporting-text;
                style: MaterialTypography.body-medium;
                color: MaterialPalette.on-surface-variant;
                overflow: elide;
            }
        }
        Icon {
            x: root.width - 40px;
            y: (root.height - self.height) / 2;
            width: 24px;
            height: 24px;
            source: Icons.chevron-right;
            colorize: MaterialPalette.on-surface-variant;
        }
    }
}

export component AboutSection inherits PageScroll {
    title: @tr("关于");

    SettingGroup {
        HorizontalLayout {
            spacing: 16px;
            Rectangle {
                width: 56px;
                height: 56px;
                border-radius: 16px;
                background: MaterialPalette.primary-container;
                Icon {
                    width: 32px;
                    height: 32px;
                    source: Icons.sports-esports;
                    colorize: MaterialPalette.on-primary-container;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                MaterialText {
                    text: "ShinkiEMU";
                    style: MaterialTypography.title-large;
                    color: MaterialPalette.on-surface;
                }
                MaterialText {
                    text: App.build != ""
                        ? @tr("版本 {0} · 构建 {1}", App.version != "" ? App.version : @tr("未知"), App.build)
                        : @tr("版本 {}", App.version != "" ? App.version : @tr("未知"));
                    style: MaterialTypography.body-medium;
                    color: MaterialPalette.on-surface-variant;
                    wrap: word-wrap;
                    overflow: clip;
                }
            }
        }
    }

    SettingGroup {
        title: @tr("开源与版权");
        MaterialText {
            text: @tr("ShinkiEMU 免费开源。请从官网或 GitHub Releases 下载；如果付费购买了软件，请向卖家申请退款。");
            style: MaterialTypography.body-medium;
            wrap: word-wrap;
            overflow: clip;
        }
        MaterialText {
            text: @tr("请使用合法取得的游戏。游戏、引擎和商标归各自权利人所有。软件按开源许可证原样提供。");
            style: MaterialTypography.body-medium;
            wrap: word-wrap;
            overflow: clip;
        }
    }

    SettingGroup {
        flush: true;

        LinkRow {
            text: @tr("致谢");
            supporting-text: @tr("上游核心、第三方组件和贡献者");
            icon: Icons.memory;
            clicked => { App.settings-category = "about-credits"; }
        }
        HorizontalDivider { }
        LinkRow {
            text: @tr("第三方许可");
            supporting-text: @tr("ShinkiEMU 使用的开源组件及其许可证");
            icon: Icons.info;
            clicked => {
                if App.android-about { AboutNav.open-licenses(false); }
                else { App.open-path("third-party-notices"); }
            }
        }
        HorizontalDivider { }
        if App.android-about : LinkRow {
            text: @tr("分享诊断日志");
            supporting-text: @tr("最近的诊断摘要");
            icon: Icons.history;
            clicked => { App.share-diagnostic-log(); }
        }
        if !App.android-about : VerticalLayout {
            LinkRow {
                text: @tr("打开数据目录");
                supporting-text: @tr("资料库、设置、封面缓存和用户安装的核心");
                icon: Icons.folder-open;
                clicked => { App.open-path("data"); }
            }
            HorizontalDivider { }
            LinkRow {
                text: @tr("打开日志目录");
                supporting-text: @tr("报告问题时请附上日志");
                icon: Icons.history;
                clicked => { App.open-path("logs"); }
            }
        }
        HorizontalDivider { }
        LinkRow {
            text: @tr("重新运行首次设置");
            supporting-text: @tr("选择库目录、联网与外观");
            icon: Icons.restart-alt;
            clicked => {
                Onboarding.step = 0;
                App.page = "onboarding";
            }
        }
    }

    SettingGroup {
        title: @tr("界面框架");
        HorizontalLayout {
            alignment: center;
            AboutSlint {
                preferred-width: 360px;
            }
        }
    }
}

export global AboutNav {
    public pure function is-subpage(category: string) -> bool {
        return category == "about-credits" || category == "about-licenses" || category == "about-license-text";
    }

    in-out property <bool> licenses-from-credits;

    public function open-licenses(from-credits: bool) {
        self.licenses-from-credits = from-credits;
        App.load-about-licenses();
        App.settings-category = "about-licenses";
    }

    public function back() {
        if App.settings-category == "about-license-text" {
            App.settings-category = "about-licenses";
        } else if App.settings-category == "about-licenses" && self.licenses-from-credits {
            App.settings-category = "about-credits";
        } else {
            App.settings-category = "about";
        }
    }
}

export component CreditsSection inherits PageScroll {
    title: @tr("致谢");

    SettingGroup {
        title: @tr("第三方组件");
        flush: true;
        LinkRow {
            text: @tr("第三方许可");
            supporting-text: @tr("ShinkiEMU 使用的开源组件及其许可证");
            icon: Icons.info;
            clicked => { AboutNav.open-licenses(true); }
        }
    }

    SettingGroup {
        title: @tr("贡献者");
        flush: true;
        LinkRow {
            text: "Project Shinkirou";
            supporting-text: @tr("ShinkiEMU 适配与测试");
            icon: Icons.build;
            clicked => { Platform.open-url("https://github.com/Project-Shinkirou/ShinkiEMU/graphs/contributors"); }
        }
    }

    MaterialText {
        text: @tr("上游核心");
        style: MaterialTypography.title-small;
        color: MaterialPalette.primary;
    }

    // The original repositories match build/cores.toml. License links refer to
    // the reviewed upstream revision, or the distributed license if absent upstream.
    // A dual-licensed card needs a second action row on compact screens.
    for credit in [
        { project: "Art3m1s Core", authors: "Alphaly2K", url: "https://github.com/Alphaly2K/art3m1s-core", license: "https://github.com/Alphaly2K/art3m1s-core/blob/ad90a62cb192b119b7cf8589aa7f87a94bd747c8/LICENSE", alternate-license: "" },
        { project: "cmvs-rs", authors: "gkouen", url: "https://github.com/Shizuku-in/cmvs-rs", license: "https://github.com/Shizuku-in/cmvs-rs/blob/b9fed68ba05f80444338331bb3999f14c8f4f976/LICENSE-MIT", alternate-license: "https://github.com/Shizuku-in/cmvs-rs/blob/b9fed68ba05f80444338331bb3999f14c8f4f976/LICENSE-APACHE" },
        { project: "ethornell-rs", authors: "xmoezzz", url: "https://github.com/xmoezzz/ethornell-rs", license: "https://github.com/Project-Shinkirou/ethornell-rs/blob/ace042bcda4ac3765a9f9198b5ffda1792b5f717/LICENSE-MPL-2.0", alternate-license: "" },
        { project: "impacto", authors: "Committee of Zero", url: "https://github.com/CommitteeOfZero/impacto", license: "https://github.com/CommitteeOfZero/impacto/blob/3706ddd89d4ad4aed0e32e127355c4251f22e574/LICENSE", alternate-license: "" },
        { project: "Kirikiroid2 Web", authors: "fenghengzhi", url: "https://github.com/fenghengzhi/kirikiroid2-web", license: "https://github.com/fenghengzhi/kirikiroid2-web/blob/2028cbccaa91498bd36f270d349ae711d0e8fed3/LICENSE", alternate-license: "" },
        { project: "KrKr2", authors: "2468785842", url: "https://github.com/2468785842/krkr2", license: "https://github.com/2468785842/krkr2/blob/dca7264572a63e753c1b07ca7053513d1751ce70/LICENSE", alternate-license: "" },
        { project: "ReMinori", authors: "luoyily", url: "https://github.com/luoyily/ReMinori", license: "https://github.com/luoyily/ReMinori/blob/79b00990324404bfbd496e7fa76c690cf040f744/LICENSE", alternate-license: "" },
        { project: "Ren’Py", authors: "Tom Rothamel", url: "https://github.com/renpy/renpy", license: "https://www.renpy.org/doc/html/license.html", alternate-license: "" },
        { project: "RFVP", authors: "xmoezzz", url: "https://github.com/xmoezzz/rfvp", license: "https://github.com/xmoezzz/rfvp/blob/99435f22e94eaec27c0c1b9f22cc2a6b1910d7d1/LICENSE", alternate-license: "" },
        { project: "Siglus RS", authors: "xmoezzz", url: "https://github.com/xmoezzz/siglus_rs", license: "https://github.com/xmoezzz/siglus_rs/blob/5f358ef1360b0439e92aed2b749e8f25d8721954/LICENSE-MPL-2.0", alternate-license: "" },
        { project: "SoftPAL RS (Sena)", authors: "404-GCross, Alphaly2K, xmoezzz", url: "https://github.com/xmoezzz/sena-rs", license: "https://github.com/xmoezzz/sena-rs/blob/7f633dbb89408297827d6c1857eb8e97dc363dff/LICENSE-MPL-2.0", alternate-license: "" },
    ] : Rectangle {
        background: MaterialPalette.surface-container-low;
        border-color: MaterialPalette.outline-variant;
        border-width: 1px;
        border-radius: 16px;
        min-height: card.min-height;
        preferred-height: card.preferred-height;

        card := VerticalLayout {
            property <bool> split-actions: credit.alternate-license != "" && self.width < 390px;
            width: parent.width;
            padding: 12px;
            spacing: 4px;
            MaterialText {
                text: credit.project;
                style: MaterialTypography.title-medium;
                wrap: word-wrap;
                overflow: clip;
            }
            MaterialText {
                text: @tr("{} 及项目贡献者", credit.authors);
                color: MaterialPalette.on-surface-variant;
                style: MaterialTypography.body-medium;
                wrap: word-wrap;
                overflow: clip;
            }
            if card.split-actions : HorizontalLayout {
                alignment: start;
                TextButton {
                    text: @tr("项目主页");
                    accessible-label: @tr("{}：项目主页", credit.project);
                    clicked => { Platform.open-url(credit.url); }
                }
            }
            HorizontalLayout {
                alignment: start;
                if !card.split-actions : TextButton {
                    text: @tr("项目主页");
                    accessible-label: @tr("{}：项目主页", credit.project);
                    clicked => { Platform.open-url(credit.url); }
                }
                TextButton {
                    text: credit.alternate-license == "" ? @tr("许可证") : "MIT";
                    accessible-label: credit.alternate-license == "" ? @tr("{}：许可证", credit.project) : credit.project + ": MIT";
                    clicked => { Platform.open-url(credit.license); }
                }
                if credit.alternate-license != "" : TextButton {
                    text: "Apache-2.0";
                    accessible-label: credit.project + ": Apache-2.0";
                    clicked => { Platform.open-url(credit.alternate-license); }
                }
            }
        }
    }
}

export component LicenseIndex inherits PageScroll {
    for file[index] in App.about-license-files : VerticalLayout {
        LinkRow {
            text: file == "THIRD_PARTY_NOTICES.md" ? @tr("第三方声明") : file;
            icon: Icons.info;
            clicked => {
                App.read-about-license(index);
                App.settings-category = "about-license-text";
            }
        }
        HorizontalDivider { }
    }
    if App.about-license-files.length == 0 : MaterialText {
        text: @tr("无法读取随包许可证。");
        wrap: word-wrap;
        overflow: clip;
    }
}

export component LicenseReader {
    TextEdit {
        x: 16px;
        y: 8px;
        width: root.width - 32px;
        height: root.height - 24px;
        read-only: true;
        wrap: char-wrap;
        accessible-label: @tr("许可证正文");
        text: App.about-license-text != "" ? App.about-license-text : @tr("无法读取随包许可证。");
    }
}
