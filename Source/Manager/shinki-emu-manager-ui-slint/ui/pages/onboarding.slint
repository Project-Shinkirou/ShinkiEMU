import { MaterialPalette, MaterialText, MaterialTypography, FilledButton, OutlineButton, TextButton, HorizontalDivider, Icon, ScrollView } from "@material";
import { App, Network, Onboarding } from "../globals.slint";
import { Icons } from "../icons.slint";
import { SettingGroup, SwitchRow } from "./settings/common.slint";
import { PathRow, EmptyLine } from "./settings/roots.slint";
import { ThemeChooser, CoverSizeChooser } from "./settings/appearance.slint";

component StepDots {
    in property <int> step;
    in property <int> count: 3;

    height: 12px;
    accessible-role: progress-indicator;
    accessible-label: @tr("第 {0} 步，共 {1} 步", root.step + 1, root.count);
    accessible-value: root.step + 1;
    accessible-value-minimum: 1;
    accessible-value-maximum: root.count;

    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        for i in root.count : Rectangle {
            width: i == root.step ? 24px : 8px;
            height: 8px;
            y: 2px;
            border-radius: 4px;
            background: i <= root.step ? MaterialPalette.primary : MaterialPalette.outline-variant;
            animate width { duration: App.appearance.reduce-motion ? 0ms : 200ms; }
        }
    }
}

component StepHeader {
    in property <image> icon;
    in property <string> title;
    in property <string> description;

    min-height: l.min-height;
    preferred-height: l.preferred-height;

    l := VerticalLayout {
        spacing: 12px;
        Rectangle {
            width: 56px;
            height: 56px;
            border-radius: 16px;
            background: MaterialPalette.primary-container;
            Icon {
                width: 28px;
                height: 28px;
                source: root.icon;
                colorize: MaterialPalette.on-primary-container;
            }
        }
        MaterialText {
            text: root.title;
            style: MaterialTypography.headline-small;
            color: MaterialPalette.on-surface;
            wrap: word-wrap;
            overflow: clip;
        }
        MaterialText {
            text: root.description;
            style: MaterialTypography.body-large;
            color: MaterialPalette.on-surface-variant;
            wrap: word-wrap;
            overflow: clip;
        }
    }
}

component RootsStep {
    min-height: l.min-height;
    preferred-height: l.preferred-height;

    l := VerticalLayout {
        spacing: 24px;
        StepHeader {
            icon: Icons.folder-open;
            title: @tr("添加库目录");
            description: @tr("选一个存放游戏的文件夹，ShinkiEMU 会自动识别游戏。也可以稍后添加。");
        }
        SettingGroup {
            flush: true;
            if Onboarding.roots.length == 0 : HorizontalLayout {
                padding: 16px;
                EmptyLine { text: @tr("还没有添加目录。"); }
            }
            for path[index] in Onboarding.roots : VerticalLayout {
                if index > 0 : HorizontalDivider { }
                PathRow {
                    path: path;
                    remove => { Onboarding.remove-root(path); }
                }
            }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 8px;
                padding-bottom: 8px;
                alignment: start;
                OutlineButton {
                    text: @tr("添加目录");
                    icon: Icons.add;
                    clicked => { Onboarding.add-root(); }
                }
            }
        }
    }
}

component NetworkStep {
    min-height: l.min-height;
    preferred-height: l.preferred-height;

    l := VerticalLayout {
        spacing: 24px;
        StepHeader {
            icon: Icons.public;
            title: @tr("联网服务");
            description: @tr("ShinkiEMU 默认不联网。开启后可以使用以下服务，随时可以在 设置→联网与资料 关闭。");
        }
        SettingGroup {
            SwitchRow {
                label: @tr("允许联网");
                description: @tr("涵盖 VNDB 资料与封面、Bangumi 同步、ShinkiEMU 元数据（兼容性、推荐配置、补丁）与核心更新，以及实时翻译。");
                value: Network.allowed;
                toggled(on) => { Network.set-allowed(on); }
            }
        }
    }
}

component AppearanceStep {
    min-height: l.min-height;
    preferred-height: l.preferred-height;

    l := VerticalLayout {
        spacing: 24px;
        StepHeader {
            icon: Icons.palette;
            title: @tr("外观");
            description: @tr("选择界面主题和游戏库封面大小。更多选项在 设置→外观。");
        }
        SettingGroup {
            ThemeChooser { }
            CoverSizeChooser { }
        }
    }
}

export component OnboardingPage {
    property <int> step: clamp(Onboarding.step, 0, 2);
    property <bool> phone: root.width < 600px;
    property <length> pad: root.phone ? 16px : 32px;
    // Landscape phones: a slimmer footer and tighter vertical rhythm keep the step content above half the height.
    property <bool> short: root.height < 480px;
    property <length> footer-height: root.short ? 56px : 80px;

    function go(next: int) {
        Onboarding.step = clamp(next, 0, 2);
    }

    function finish() {
        Onboarding.finish();
    }

    forward-focus: keys;

    init => { keys.focus(); }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape || event.text == Key.Back {
                root.finish();
                return accept;
            }
            reject
        }
    }

    Rectangle {
        background: MaterialPalette.surface;
    }

    sv := ScrollView {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height - root.footer-height;

        HorizontalLayout {
            width: sv.visible-width;
            padding-left: root.pad;
            padding-right: root.pad;
            padding-top: root.short ? 16px : root.pad;
            padding-bottom: root.short ? 16px : root.pad;
            alignment: center;

            VerticalLayout {
                width: min(600px, sv.visible-width - 2 * root.pad);
                spacing: root.short ? 16px : 32px;
                alignment: start;

                HorizontalLayout {
                    spacing: 12px;
                    MaterialText {
                        horizontal-stretch: 1;
                        text: @tr("欢迎使用 ShinkiEMU");
                        style: MaterialTypography.title-medium;
                        color: MaterialPalette.primary;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        horizontal-stretch: 0;
                        alignment: center;
                        StepDots { step: root.step; }
                    }
                }

                if root.step == 0 : RootsStep { }
                if root.step == 1 : NetworkStep { }
                if root.step == 2 : AppearanceStep { }
            }
        }
    }

    Rectangle {
        x: 0px;
        y: root.height - root.footer-height;
        width: root.width;
        height: root.footer-height;
        background: MaterialPalette.surface-container;

        HorizontalLayout {
            padding-left: root.phone ? 8px : root.pad;
            padding-right: root.phone ? 8px : root.pad;
            spacing: 8px;
            alignment: center;

            HorizontalLayout {
                width: min(600px, root.width - 2 * (root.phone ? 8px : root.pad));
                spacing: root.phone ? 4px : 8px;

                // On phones Skip collapses to its short label so Back and the primary action stay whole.
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    TextButton {
                        text: root.phone ? @tr("跳过") : @tr("跳过引导");
                        clicked => { root.finish(); }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                if root.step > 0 : VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    OutlineButton {
                        text: @tr("上一步");
                        clicked => { root.go(root.step - 1); }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    FilledButton {
                        text: root.step == 2 ? @tr("完成") : @tr("下一步");
                        icon: root.step == 2 && !root.phone ? Icons.check : @image-url("");
                        clicked => {
                            if root.step == 2 {
                                root.finish();
                            } else {
                                root.go(root.step + 1);
                            }
                        }
                    }
                }
            }
        }
    }
}
