import { MaterialPalette, MaterialText, MaterialTypography, FilledButton, TonalButton, OutlineButton, TextButton, LinearProgressIndicator, HorizontalDivider, Icon, ScrollView } from "@material";
import { App, Library, Network, Onboarding, ResaleNoticeState } from "../globals.slint";
import { Icons } from "../icons.slint";
import { SettingGroup, SwitchRow } from "./settings/common.slint";
import { PathRow, EmptyLine } from "./settings/roots.slint";
import { ThemeChooser, CoverSizeChooser } from "./settings/appearance.slint";
import { DisclaimerText } from "../components/disclaimer.slint";
import { ResaleNoticeSlot, ResaleNoticeAck } from "../components/resale-notice.slint";

component StepDots {
    in property <int> step;
    in property <int> count: 5;

    height: 12px;
    accessible-role: progress-indicator;
    accessible-label: @tr("第 {0} 步，共 {1} 步", root.step + 1, root.count);
    accessible-value: root.step + 1;
    accessible-value-minimum: 1;
    accessible-value-maximum: root.count;

    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        for i in root.count : Rectangle {
            width: i == root.step ? 24px : 8px;
            height: 8px;
            y: 2px;
            border-radius: 4px;
            background: i <= root.step ? MaterialPalette.primary : MaterialPalette.outline-variant;
            animate width { duration: App.appearance.reduce-motion ? 0ms : 200ms; }
        }
    }
}

component StepHeader {
    in property <image> icon;
    in property <string> title;
    in property <string> description;

    min-height: l.min-height;
    preferred-height: l.preferred-height;

    l := VerticalLayout {
        spacing: 12px;
        Rectangle {
            width: 56px;
            height: 56px;
            border-radius: 16px;
            background: MaterialPalette.primary-container;
            Icon {
                width: 28px;
                height: 28px;
                source: root.icon;
                colorize: MaterialPalette.on-primary-container;
            }
        }
        MaterialText {
            text: root.title;
            style: MaterialTypography.headline-small;
            color: MaterialPalette.on-surface;
            wrap: word-wrap;
            overflow: clip;
        }
        MaterialText {
            text: root.description;
            style: MaterialTypography.body-large;
            color: MaterialPalette.on-surface-variant;
            wrap: word-wrap;
            overflow: clip;
        }
    }
}

component DisclaimerStep {
    in property <bool> wide: true;

    min-height: l.min-height;
    preferred-height: l.preferred-height;

    l := VerticalLayout {
        spacing: 24px;
        StepHeader {
            icon: Icons.info;
            title: @tr("开始之前");
            description: @tr("请先阅读以下说明。以后可以在 设置→关于 再次查看。");
        }
        VerticalLayout {
            spacing: 8px;
            ResaleNoticeSlot { wide: root.wide; }
            ResaleNoticeAck { }
        }
        SettingGroup {
            DisclaimerText { }
        }
    }
}

component RootsStep {
    min-height: l.min-height;
    preferred-height: l.preferred-height;

    l := VerticalLayout {
        spacing: 24px;
        StepHeader {
            icon: Icons.folder-open;
            title: @tr("添加库目录");
            description: @tr("选择存放游戏的文件夹，ShinkiEMU 会在其中识别作品。以后也可以在 设置→库目录 修改，这一步可以跳过。");
        }
        SettingGroup {
            flush: true;
            if Onboarding.roots.length == 0 : HorizontalLayout {
                padding: 16px;
                EmptyLine { text: @tr("还没有添加目录。"); }
            }
            for path[index] in Onboarding.roots : VerticalLayout {
                if index > 0 : HorizontalDivider { }
                PathRow {
                    path: path;
                    remove => { Onboarding.remove-root(path); }
                }
            }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 8px;
                padding-bottom: 8px;
                alignment: start;
                OutlineButton {
                    text: @tr("添加目录");
                    icon: Icons.add;
                    clicked => { Onboarding.add-root(); }
                }
            }
        }
    }
}

component NetworkStep {
    min-height: l.min-height;
    preferred-height: l.preferred-height;

    l := VerticalLayout {
        spacing: 24px;
        StepHeader {
            icon: Icons.public;
            title: @tr("联网服务");
            description: @tr("ShinkiEMU 默认不联网。开启后可以使用以下服务，随时可以在 设置→联网与资料 关闭。");
        }
        SettingGroup {
            SwitchRow {
                label: @tr("允许联网");
                description: @tr("涵盖 VNDB 资料与封面、Bangumi 同步、ShinkiEMU 元数据（兼容性、推荐配置、补丁）与核心更新，以及实时翻译。");
                value: Network.allowed;
                toggled(on) => { Network.set-allowed(on); }
            }
        }
    }
}

component AppearanceStep {
    min-height: l.min-height;
    preferred-height: l.preferred-height;

    l := VerticalLayout {
        spacing: 24px;
        StepHeader {
            icon: Icons.palette;
            title: @tr("外观");
            description: @tr("选择界面主题和游戏库封面大小。更多选项在 设置→外观。");
        }
        SettingGroup {
            ThemeChooser { }
            CoverSizeChooser { }
        }
    }
}

component PrepareStep {
    property <bool> busy: Library.prepare-state == "loading-cores" || Library.prepare-state == "scanning";
    property <bool> done: Library.prepare-state == "ready";
    property <bool> failed: Library.prepare-state == "failed";

    min-height: l.min-height;
    preferred-height: l.preferred-height;

    l := VerticalLayout {
        spacing: 24px;
        StepHeader {
            icon: Icons.library-books;
            title: @tr("准备资料库");
            description: @tr("加载模拟器核心并扫描库目录。作品较多时可能需要一些时间，可以先完成引导，在游戏库中查看进度。");
        }
        SettingGroup {
            if !root.busy : HorizontalLayout {
                alignment: start;
                FilledButton {
                    text: root.done ? @tr("重新扫描") : root.failed ? @tr("重试") : @tr("开始准备");
                    icon: root.done ? Icons.refresh : Icons.play-arrow;
                    clicked => { Library.prepare(); }
                }
            }
            if root.busy : VerticalLayout {
                spacing: 12px;
                LinearProgressIndicator {
                    indeterminate: Library.prepare-progress < 0;
                    progress: max(Library.prepare-progress, 0);
                }
                HorizontalLayout {
                    spacing: 8px;
                    MaterialText {
                        horizontal-stretch: 1;
                        text: Library.prepare-detail != "" ? Library.prepare-detail : Library.prepare-state == "loading-cores" ? @tr("正在加载核心…") : @tr("正在扫描…");
                        style: MaterialTypography.body-medium;
                        color: MaterialPalette.on-surface-variant;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        overflow: clip;
                    }
                    if Library.can-cancel-prepare : TextButton {
                        text: @tr("取消");
                        clicked => { Library.cancel-prepare(); }
                    }
                }
            }
            if !root.busy && (root.done || root.failed) : HorizontalLayout {
                spacing: 8px;
                Icon {
                    width: 20px;
                    height: 20px;
                    source: root.failed ? Icons.error : Icons.check;
                    colorize: root.failed ? MaterialPalette.error : MaterialPalette.primary;
                }
                MaterialText {
                    horizontal-stretch: 1;
                    text: root.failed ? (Library.prepare-detail != "" ? Library.prepare-detail : @tr("准备失败，请查看核心诊断"))
                        : Library.prepare-detail != "" ? Library.prepare-detail : @tr("资料库已准备好，共 {n} 部作品" | "资料库已准备好，共 {n} 部作品" % Library.games.length);
                    style: MaterialTypography.body-medium;
                    color: root.failed ? MaterialPalette.error : MaterialPalette.on-surface;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    overflow: clip;
                }
            }
        }
    }
}

export component OnboardingPage {
    property <int> step: clamp(Onboarding.step, 0, 4);
    property <bool> phone: root.width < 600px;
    property <length> pad: root.phone ? 16px : 32px;
    // Landscape phones: a slimmer footer and tighter vertical rhythm keep the step content above half the height.
    property <bool> short: root.height < 480px;
    property <length> footer-height: root.short ? 56px : 80px;

    function go(next: int) {
        Onboarding.step = clamp(next, 0, 4);
    }

    function finish() {
        Onboarding.finish();
        App.page = "library";
    }

    // The host keeps onboarding on step 0 and rejects finishing until the
    // notice is acknowledged; leaving early from here would desync the page.
    property <bool> can-leave: root.step != 0 || ResaleNoticeState.acknowledged;

    // Scroll viewport used by Rust to validate that the complete image is visible.
    property <{x: length, y: length, width: length, height: length}> viewport: {
        x: sv.absolute-position.x,
        y: sv.absolute-position.y,
        width: sv.visible-width,
        height: sv.visible-height,
    };

    function report-viewport() {
        ResaleNoticeState.report-onboarding-clip(root.viewport.x, root.viewport.y, root.viewport.width, root.viewport.height);
    }

    init => { root.report-viewport(); }
    changed viewport => { root.report-viewport(); }

    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape || event.text == Key.Back {
                if root.can-leave {
                    root.finish();
                }
                return accept;
            }
            reject
        }
    }

    Rectangle {
        background: MaterialPalette.surface;
    }

    sv := ScrollView {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height - root.footer-height;

        HorizontalLayout {
            width: sv.visible-width;
            padding-left: root.pad;
            padding-right: root.pad;
            padding-top: root.short ? 16px : root.pad;
            padding-bottom: root.short ? 16px : root.pad;
            alignment: center;

            VerticalLayout {
                width: min(600px, sv.visible-width - 2 * root.pad);
                spacing: root.short ? 16px : 32px;
                alignment: start;

                HorizontalLayout {
                    spacing: 12px;
                    MaterialText {
                        horizontal-stretch: 1;
                        text: @tr("欢迎使用 ShinkiEMU");
                        style: MaterialTypography.title-medium;
                        color: MaterialPalette.primary;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        horizontal-stretch: 0;
                        alignment: center;
                        StepDots { step: root.step; }
                    }
                }

                if root.step == 0 : DisclaimerStep { wide: !root.phone; }
                if root.step == 1 : RootsStep { }
                if root.step == 2 : NetworkStep { }
                if root.step == 3 : AppearanceStep { }
                if root.step == 4 : PrepareStep { }
            }
        }
    }

    Rectangle {
        x: 0px;
        y: root.height - root.footer-height;
        width: root.width;
        height: root.footer-height;
        background: MaterialPalette.surface-container;

        HorizontalLayout {
            padding-left: root.pad;
            padding-right: root.pad;
            spacing: 8px;
            alignment: center;

            HorizontalLayout {
                width: min(600px, root.width - 2 * root.pad);
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    TextButton {
                        text: @tr("跳过引导");
                        enabled: root.can-leave;
                        clicked => { root.finish(); }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                if root.step > 0 : VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    OutlineButton {
                        text: @tr("上一步");
                        clicked => { root.go(root.step - 1); }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    FilledButton {
                        text: root.step == 4 ? @tr("完成")
                            : root.step == 0 && !ResaleNoticeState.acknowledged && ResaleNoticeState.remaining-seconds > 0 ? @tr("下一步（{} 秒）", ResaleNoticeState.remaining-seconds)
                            : @tr("下一步");
                        icon: root.step == 4 ? Icons.check : @image-url("");
                        enabled: root.step != 0 || ResaleNoticeState.acknowledged;
                        clicked => {
                            if root.step == 4 {
                                root.finish();
                            } else {
                                root.go(root.step + 1);
                            }
                        }
                    }
                }
            }
        }
    }
}
