    in-out property <int> step: 1;
    in-out property <PatchState> state;
    callback search(string);
    callback select-game(string);
    callback select-recipe(string);
    callback pick-script();
    // "patch" | "output"
    callback pick-directory(string);
    callback set-mode(bool);
    callback download(string);
    callback restore();
    callback start();
    callback cancel();
    callback open-output();
