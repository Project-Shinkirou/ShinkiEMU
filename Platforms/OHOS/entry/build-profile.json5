{
  "apiType": "stageMode",
  "buildOption": {
    // libs/<abi> holds the one target's prebuilt Rust libraries staged by xtask.
    "nativeLib": {
      // Musica is already release-built. core.json and the signed HAP
      // receipt verify the exact library bytes staged before hvigor.
      "debugSymbol": { "strip": true, "exclude": ["**/libshinki_emu_core_musica.so"] }
    }
  },
  "targets": [{ "name": "default" }]
}
