{
  "apiType": "stageMode",
  "buildOption": {
    // xtask stages all native components for one ABI in libs/<abi>.
    "nativeLib": {
      // Preserve the exact prebuilt library bytes checked by the HAP packager.
      "debugSymbol": { "strip": false }
    }
  },
  "targets": [{ "name": "default" }]
}
