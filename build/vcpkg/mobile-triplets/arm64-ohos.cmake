set(VCPKG_TARGET_ARCHITECTURE arm64)
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE static)
set(VCPKG_CMAKE_SYSTEM_NAME Linux)
if(NOT DEFINED ENV{OHOS_SDK_NATIVE})
    message(FATAL_ERROR "OHOS_SDK_NATIVE must point to the DevEco native SDK")
endif()
file(TO_CMAKE_PATH "$ENV{OHOS_SDK_NATIVE}" SHINKI_OHOS_NATIVE)
set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE "${CMAKE_CURRENT_LIST_DIR}/ohos-toolchain.cmake")
set(VCPKG_MAKE_BUILD_TRIPLET "--host=aarch64-unknown-linux-ohos")
set(VCPKG_CMAKE_CONFIGURE_OPTIONS -DOHOS_ARCH=arm64-v8a -DOHOS_PLATFORM_LEVEL=17 -DCMAKE_PLATFORM_NO_VERSIONED_SONAME=ON)
# FFmpeg 7.1.2's port predates vcpkg's OHOS dispatch. Select its Linux/musl
# configure branch while the chainloaded DevEco toolchain still targets OHOS.
if(PORT STREQUAL "ffmpeg")
    set(VCPKG_CMAKE_SYSTEM_NAME Linux)
endif()
if(PORT STREQUAL "libass")
    set(VCPKG_MESON_CONFIGURE_OPTIONS -Dfontconfig=disabled -Dcoretext=disabled -Ddirectwrite=disabled)
endif()
